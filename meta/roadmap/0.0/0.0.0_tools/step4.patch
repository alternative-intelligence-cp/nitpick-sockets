diff --git a/tests/probe/probe07_io_ready.npk b/tests/probe/probe07_io_ready.npk
new file mode 100644
index 0000000..fb3813e
--- /dev/null
+++ b/tests/probe/probe07_io_ready.npk
@@ -0,0 +1,110 @@
+// expect-exit: 0
+//
+// PROBE 07 -- `io_ready` AND `io_ready2` ON SOCKETS.
+//
+// ASKS: the prelude's reactor waits on a `socketpair`, each with a deadline: `io_ready(descr, 1,
+// within)` (EPOLLIN) with a byte pending returns well before its deadline; the same with nothing
+// pending answers `DeadlineExceeded`, no sooner than the deadline; `io_ready(descr, 4, within)`
+// (EPOLLOUT) on a writable socket returns; `io_ready2` over both ends with only one readable
+// returns; and over two with neither readable answers `DeadlineExceeded`. A descriptor is the
+// reactor's `int32` -- `(o.value) =>! int32` at each call.
+// DEPENDS ON THE ANSWER: `CONCURRENCY_MODEL.md` §1 -- every wait in the library is one of these --
+// and `io_ready2` is what makes fan-in expressible without a `select` the language does not have.
+// EXPECTED: exit 0 at -O0 and through `opt -O2`. Codes 10 ... 29 are the assertions; the time
+// bounds are wide (a ready wait under 900 ms of a 1 s deadline; an expired one no sooner than its
+// 20 ms), so the probe states a verdict, not a rate.
+mod:probe07_io_ready;
+
+fixed int64:SYS_SENDTO = 44i64;
+fixed int64:SYS_RECVFROM = 45i64;
+fixed int64:SYS_SOCKETPAIR = 53i64;
+fixed int64:AF_UNIX = 1i64;
+fixed int64:SOCK_STREAM = 1i64;
+fixed int64:SOCK_NONBLOCK = 2048i64;
+fixed int64:SOCK_CLOEXEC = 524288i64;
+fixed int64:MSG_NOSIGNAL = 16384i64;
+fixed int32:EV_IN = 1i32;
+fixed int32:EV_OUT = 4i32;
+fixed int64:MS = 1000000i64;
+
+error:ESend;
+error:ERecv;
+
+func:send_one = NIL(OwnedFd->:o) {
+    wild int8->:one = calloc(1i64, 8i64);
+    <-one = 7i8;
+    Result<int64>:r = sys(SYS_SENDTO, o.value, one, 1i64, MSG_NOSIGNAL, 0i64, 0i64);
+    dalloc(one);
+    if (r.is_error) { fail ESend; }
+    pass NIL;
+};
+
+func:recv_one = NIL(OwnedFd->:o) {
+    wild int8->:one = calloc(1i64, 8i64);
+    Result<int64>:r = sys(SYS_RECVFROM, o.value, one, 1i64, 0i64, 0i64, 0i64);
+    dalloc(one);
+    if (r.is_error) { fail ERecv; }
+    pass NIL;
+};
+
+async func:main = int32(cstring[]:_~argv) {
+    wild int8->:sv = alloc(8i64);
+    int64:kind = (SOCK_STREAM | SOCK_NONBLOCK) | SOCK_CLOEXEC;
+    Result<int64>:rp = sys(SYS_SOCKETPAIR, AF_UNIX, kind, 0i64, sv);
+    if (rp.is_error) { exit 10i32; }
+    OwnedFd:a = own_fd(((<-(#ptr_add<int32>(sv, 0i64)))) =>! fd);
+    OwnedFd:b = own_fd(((<-(#ptr_add<int32>(sv, 1i64)))) =>! fd);
+    dalloc(sv);
+    int32:ia = (a.value) =>! int32;
+    int32:ib = (b.value) =>! int32;
+
+    // readable with a byte pending: well inside the deadline
+    send_one(@a) ?! ESend;
+    int64:t0 = mono_now();
+    Result<NIL>:w1 = await io_ready(ib, EV_IN, raw duration_ms(1000i64));
+    if (w1.is_error) { exit 11i32; }
+    if (((mono_now()) - t0) >= (900i64 * MS)) { exit 12i32; }
+    recv_one(@b) ?! ERecv;
+
+    // nothing pending: the deadline's, no sooner than it
+    int64:t1 = mono_now();
+    Result<NIL>:w2 = await io_ready(ib, EV_IN, raw duration_ms(20i64));
+    if (!w2.is_error) { exit 13i32; }
+    if (w2.err != DeadlineExceeded) { exit 14i32; }
+    if (((mono_now()) - t1) < (20i64 * MS)) { exit 15i32; }
+
+    // writable
+    Result<NIL>:w3 = await io_ready(ia, EV_OUT, raw duration_ms(1000i64));
+    if (w3.is_error) { exit 16i32; }
+
+    // two descriptors, one readable
+    send_one(@a) ?! ESend;
+    int64:t2 = mono_now();
+    Result<NIL>:w4 = await io_ready2(ia, EV_IN, ib, EV_IN, raw duration_ms(1000i64));
+    if (w4.is_error) { exit 17i32; }
+    if (((mono_now()) - t2) >= (900i64 * MS)) { exit 18i32; }
+    recv_one(@b) ?! ERecv;
+
+    // two descriptors, neither readable
+    Result<NIL>:w5 = await io_ready2(ia, EV_IN, ib, EV_IN, raw duration_ms(20i64));
+    if (!w5.is_error) { exit 19i32; }
+    if (w5.err != DeadlineExceeded) { exit 20i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (ESend)             { exit 21i32; },
+        (ERecv)             { exit 22i32; },
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DeadlineExceeded)  { exit 111i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/probe/probe08_connect_inprogress.npk b/tests/probe/probe08_connect_inprogress.npk
new file mode 100644
index 0000000..1daff9c
--- /dev/null
+++ b/tests/probe/probe08_connect_inprogress.npk
@@ -0,0 +1,196 @@
+// expect-exit: 0
+//
+// PROBE 08 -- `connect`'S IN-PROGRESS PATH, ITS FAILURE AND ITS SUCCESS.
+//
+// ASKS: a non-blocking TCP `connect` on 127.0.0.1, three times, each waited on for EPOLLOUT:
+//   A. to a CLOSED port (one bound to port 0, read back, and closed): `connect` answers an error that
+//      is none of the prelude's named five; the socket turns writable; `getsockopt(SOL_SOCKET,
+//      SO_ERROR)` reads 111, `ECONNREFUSED`, as data; and a second read reads 0;
+//   B. the same, but after the wait `getpeername` fails and a SECOND `connect` answers the pending
+//      error itself -- an error unlike the first, which then leaves `SO_ERROR` at 0;
+//   C. to a listener on port 0 in this program: `connect` answers the SAME error as A's first --
+//      `EINPROGRESS`, identified by identity, since no program can name it (probe 13) -- the socket
+//      turns writable, `SO_ERROR` reads 0, `getpeername` succeeds, a second `connect` answers
+//      SUCCESS, a third an error unlike every other here (`EISCONN`), and the listener's `accept4`
+//      takes the peer.
+// DEPENDS ON THE ANSWER: SK-014's protocol. At this pin a program compares an errno only with a
+// prelude identity or another error (probe 13), so the protocol must tell its cases apart
+// without naming `EINPROGRESS`: by readiness and a second `connect`, which answers success once the
+// connection is made and otherwise hands back the kernel's own error, to forward verbatim
+// (`SAFETY.md` S-6).
+// EXPECTED: exit 0 at -O0 and through `opt -O2`. Codes 10 ... 59 are the assertions. A loopback
+// connect may complete or fail at once on another kernel; at this machine's it does neither.
+mod:probe08_connect_inprogress;
+
+fixed int64:SYS_CLOSE = 3i64;
+fixed int64:SYS_SOCKET = 41i64;
+fixed int64:SYS_CONNECT = 42i64;
+fixed int64:SYS_BIND = 49i64;
+fixed int64:SYS_LISTEN = 50i64;
+fixed int64:SYS_GETSOCKNAME = 51i64;
+fixed int64:SYS_GETPEERNAME = 52i64;
+fixed int64:SYS_GETSOCKOPT = 55i64;
+fixed int64:SYS_ACCEPT4 = 288i64;
+fixed int64:AF_INET = 2i64;
+fixed int64:SOCK_STREAM = 1i64;
+fixed int64:SOCK_NONBLOCK = 2048i64;
+fixed int64:SOCK_CLOEXEC = 524288i64;
+fixed int64:SOL_SOCKET = 1i64;
+fixed int64:SO_ERROR = 4i64;
+fixed int32:EV_OUT = 4i32;
+fixed int64:ECONNREFUSED_NUMBER = 111i64;
+
+struct:SockaddrIn = { uint16:family; uint16:port_be; uint8[4]:addr; uint8[8]:zero; };
+
+// A fresh non-blocking TCP socket, or -1.
+func:tcp_socket = int64() never fails {
+    int64:kind = (SOCK_STREAM | SOCK_NONBLOCK) | SOCK_CLOEXEC;
+    Result<int64>:r = sys(SYS_SOCKET, AF_INET, kind, 0i64);
+    if (r.is_error) { pass 0i64 - 1i64; }
+    pass r.value;
+};
+
+// 127.0.0.1 and `port_be` (already in network order) written into a zeroed 16-byte block.
+func:loopback = wild int8->(uint16:port_be) never fails {
+    wild int8->:blk = calloc(1i64, 16i64);
+    wild SockaddrIn->:sa = blk =>! wild SockaddrIn->;
+    sa.family = 2u16;
+    sa.port_be = port_be;
+    sa.addr[0i64] = 127u8;
+    sa.addr[3i64] = 1u8;
+    pass blk;
+};
+
+// The socket's `SO_ERROR`, read as data, or -1.
+func:so_error = int64(int64:s) never fails {
+    wild int8->:val = calloc(1i64, 8i64);
+    wild int8->:len = calloc(1i64, 8i64);
+    <-(#ptr_add<int32>(len, 0i64)) = 4i32;
+    Result<int64>:r = sys(SYS_GETSOCKOPT, s, SOL_SOCKET, SO_ERROR, val, len);
+    int64:v = (<-(#ptr_add<int32>(val, 0i64))) => int64;
+    dalloc(val);
+    dalloc(len);
+    if (r.is_error) { pass 0i64 - 1i64; }
+    pass v;
+};
+
+// A socket bound to 127.0.0.1:0, its port read back (network order) into `out`, the socket returned.
+func:bound_any = int64(wild int8->:out) never fails {
+    int64:s = raw tcp_socket();
+    if (s < 0i64) { pass 0i64 - 1i64; }
+    wild int8->:blk = raw loopback(0u16);
+    wild int8->:len = calloc(1i64, 8i64);
+    <-(#ptr_add<int32>(len, 0i64)) = 16i32;
+    Result<int64>:rb = sys(SYS_BIND, s, blk, 16i64);
+    Result<int64>:rg = sys(SYS_GETSOCKNAME, s, blk, len);
+    wild SockaddrIn->:sa = blk =>! wild SockaddrIn->;
+    <-(#ptr_add<uint16>(out, 0i64)) = sa.port_be;
+    dalloc(blk);
+    dalloc(len);
+    if (rb.is_error) { pass 0i64 - 1i64; }
+    if (rg.is_error) { pass 0i64 - 1i64; }
+    pass s;
+};
+
+async func:main = int32(cstring[]:_~argv) {
+    // a closed port: bound, read back, closed
+    wild int8->:portw = calloc(1i64, 8i64);
+    int64:gone = raw bound_any(portw);
+    if (gone < 0i64) { exit 10i32; }
+    uint16:closed_port = <-(#ptr_add<uint16>(portw, 0i64));
+    Result<int64>:cg = sys(SYS_CLOSE, gone);
+    if (cg.is_error) { exit 11i32; }
+    wild int8->:to_closed = raw loopback(closed_port);
+
+    // A: SO_ERROR after the wait, then again
+    int64:sa = raw tcp_socket();
+    if (sa < 0i64) { exit 12i32; }
+    Result<int64>:ca = sys(SYS_CONNECT, sa, to_closed, 16i64);
+    if (!ca.is_error) { exit 13i32; }
+    if (ca.err == WouldBlock) { exit 14i32; }
+    if (ca.err == Interrupted) { exit 15i32; }
+    if (ca.err == NotFound) { exit 16i32; }
+    if (ca.err == Exists) { exit 17i32; }
+    if (ca.err == CrossDevice) { exit 18i32; }
+    Result<NIL>:wa = await io_ready((sa =>! int32), EV_OUT, raw duration_ms(1000i64));
+    if (wa.is_error) { exit 19i32; }
+    if ((raw so_error(sa)) != ECONNREFUSED_NUMBER) { exit 20i32; }
+    if ((raw so_error(sa)) != 0i64) { exit 21i32; }
+    Result<int64>:xa = sys(SYS_CLOSE, sa);
+    if (xa.is_error) { exit 22i32; }
+
+    // B: getpeername, then a second connect hands back the pending error
+    int64:sb = raw tcp_socket();
+    if (sb < 0i64) { exit 23i32; }
+    Result<int64>:cb1 = sys(SYS_CONNECT, sb, to_closed, 16i64);
+    if (!cb1.is_error) { exit 24i32; }
+    if (cb1.err != ca.err) { exit 25i32; }
+    Result<NIL>:wb = await io_ready((sb =>! int32), EV_OUT, raw duration_ms(1000i64));
+    if (wb.is_error) { exit 26i32; }
+    wild int8->:peer = calloc(1i64, 16i64);
+    wild int8->:peerlen = calloc(1i64, 8i64);
+    <-(#ptr_add<int32>(peerlen, 0i64)) = 16i32;
+    Result<int64>:pb = sys(SYS_GETPEERNAME, sb, peer, peerlen);
+    if (!pb.is_error) { exit 27i32; }
+    Result<int64>:cb2 = sys(SYS_CONNECT, sb, to_closed, 16i64);
+    if (!cb2.is_error) { exit 28i32; }
+    if (cb2.err == cb1.err) { exit 29i32; }
+    if ((raw so_error(sb)) != 0i64) { exit 30i32; }
+    Result<int64>:xb = sys(SYS_CLOSE, sb);
+    if (xb.is_error) { exit 31i32; }
+
+    // C: a listener, and the same first answer
+    int64:lsn = raw bound_any(portw);
+    if (lsn < 0i64) { exit 32i32; }
+    Result<int64>:rl = sys(SYS_LISTEN, lsn, 8i64);
+    if (rl.is_error) { exit 33i32; }
+    wild int8->:to_lsn = raw loopback(<-(#ptr_add<uint16>(portw, 0i64)));
+    int64:sc = raw tcp_socket();
+    if (sc < 0i64) { exit 34i32; }
+    Result<int64>:cc1 = sys(SYS_CONNECT, sc, to_lsn, 16i64);
+    if (!cc1.is_error) { exit 35i32; }
+    if (cc1.err != ca.err) { exit 36i32; }
+    Result<NIL>:wc = await io_ready((sc =>! int32), EV_OUT, raw duration_ms(1000i64));
+    if (wc.is_error) { exit 37i32; }
+    if ((raw so_error(sc)) != 0i64) { exit 38i32; }
+    <-(#ptr_add<int32>(peerlen, 0i64)) = 16i32;
+    Result<int64>:pc = sys(SYS_GETPEERNAME, sc, peer, peerlen);
+    if (pc.is_error) { exit 39i32; }
+    Result<int64>:cc2 = sys(SYS_CONNECT, sc, to_lsn, 16i64);
+    if (cc2.is_error) { exit 40i32; }
+    Result<int64>:cc3 = sys(SYS_CONNECT, sc, to_lsn, 16i64);
+    if (!cc3.is_error) { exit 41i32; }
+    if (cc3.err == cc1.err) { exit 42i32; }
+    if (cc3.err == cb2.err) { exit 47i32; }
+    int64:kind = SOCK_NONBLOCK | SOCK_CLOEXEC;
+    Result<int64>:acc = sys(SYS_ACCEPT4, lsn, 0i64, 0i64, kind);
+    if (acc.is_error) { exit 43i32; }
+    dalloc(peer);
+    dalloc(peerlen);
+    dalloc(portw);
+    dalloc(to_closed);
+    dalloc(to_lsn);
+    Result<int64>:x1 = sys(SYS_CLOSE, acc.value);
+    Result<int64>:x2 = sys(SYS_CLOSE, sc);
+    Result<int64>:x3 = sys(SYS_CLOSE, lsn);
+    if (x1.is_error) { exit 44i32; }
+    if (x2.is_error) { exit 45i32; }
+    if (x3.is_error) { exit 46i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DeadlineExceeded)  { exit 111i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/probe/probe11_scm_rights.npk b/tests/probe/probe11_scm_rights.npk
new file mode 100644
index 0000000..2d7ac95
--- /dev/null
+++ b/tests/probe/probe11_scm_rights.npk
@@ -0,0 +1,152 @@
+// expect-exit: 0
+//
+// PROBE 11 -- `SCM_RIGHTS` OVER A `socketpair`, RECEIVED WITH `MSG_CMSG_CLOEXEC`.
+//
+// ASKS: a pipe holding three bytes, its read end passed over a `socketpair` by `sendmsg` with one
+// payload byte and one `cmsghdr` of `SOL_SOCKET`/`SCM_RIGHTS` -- `cmsg_len` = `CMSG_LEN(4)` = 20 in a
+// control buffer of `CMSG_SPACE(4)` = 24 -- and received by `recvmsg` with `MSG_CMSG_CLOEXEC`
+// (0x40000000) in its flags word. The received descriptor is a different number, the control
+// length and the header come back as sent, reading through it gives the pipe's bytes, and
+// `fcntl(F_GETFD)` reports `FD_CLOEXEC` -- so the flag reached the kernel through `sys`.
+// DEPENDS ON THE ANSWER: `ANCILLARY_MODEL.md` end to end -- N-2's distinction between `CMSG_LEN`
+// and `CMSG_SPACE`, and the rule that every received descriptor is close-on-exec atomically.
+// EXPECTED: exit 0 at -O0 and through `opt -O2`. Codes 10 ... 39 are the assertions.
+mod:probe11_scm_rights;
+
+fixed int64:SYS_READ = 0i64;
+fixed int64:SYS_WRITE = 1i64;
+fixed int64:SYS_CLOSE = 3i64;
+fixed int64:SYS_SENDMSG = 46i64;
+fixed int64:SYS_RECVMSG = 47i64;
+fixed int64:SYS_SOCKETPAIR = 53i64;
+fixed int64:SYS_FCNTL = 72i64;
+fixed int64:SYS_PIPE2 = 293i64;
+fixed int64:AF_UNIX = 1i64;
+fixed int64:SOCK_STREAM = 1i64;
+fixed int64:SOCK_NONBLOCK = 2048i64;
+fixed int64:SOCK_CLOEXEC = 524288i64;
+fixed int64:PIPE_CLOEXEC = 524288i64;
+fixed int64:MSG_NOSIGNAL = 16384i64;
+fixed int64:MSG_CMSG_CLOEXEC = 1073741824i64;
+fixed int32:SOL_SOCKET = 1i32;
+fixed int32:SCM_RIGHTS = 1i32;
+fixed int64:F_GETFD = 1i64;
+fixed int64:FD_CLOEXEC = 1i64;
+fixed int64:CMSG_LEN_ONE_FD = 20i64;
+fixed int64:CMSG_SPACE_ONE_FD = 24i64;
+
+// `msg_namelen` and `msg_flags` as one 8-byte word each, covering the `int32` and its padding (N-1).
+struct:MsgHdr = {
+    wild int8->:name; int64:namelen;
+    wild int8->:iov; uint64:iovlen;
+    wild int8->:control; uint64:controllen;
+    int64:flags;
+};
+struct:IoVec = { wild int8->:base; uint64:len; };
+struct:CmsgFd = { uint64:len; int32:level; int32:ctype; int32:passed; int32:pad; };
+
+func:main = int32(cstring[]:_~argv) {
+    if (#size_of<CmsgFd>() != CMSG_SPACE_ONE_FD) { exit 10i32; }
+    // the pipe, three bytes in it
+    wild int8->:pv = alloc(8i64);
+    Result<int64>:rp = sys(SYS_PIPE2, pv, PIPE_CLOEXEC);
+    if (rp.is_error) { exit 11i32; }
+    int64:pr = (<-(#ptr_add<int32>(pv, 0i64))) => int64;
+    int64:pw = (<-(#ptr_add<int32>(pv, 1i64))) => int64;
+    dalloc(pv);
+    wild int8->:xyz = calloc(1i64, 8i64);
+    <-(#ptr_add<uint8>(xyz, 0i64)) = 120u8;
+    <-(#ptr_add<uint8>(xyz, 1i64)) = 121u8;
+    <-(#ptr_add<uint8>(xyz, 2i64)) = 122u8;
+    Result<int64>:rw = sys(SYS_WRITE, pw, xyz, 3i64);
+    dalloc(xyz);
+    if (rw.is_error) { exit 12i32; }
+
+    // the socketpair
+    wild int8->:sv = alloc(8i64);
+    int64:kind = (SOCK_STREAM | SOCK_NONBLOCK) | SOCK_CLOEXEC;
+    Result<int64>:rs = sys(SYS_SOCKETPAIR, AF_UNIX, kind, 0i64, sv);
+    if (rs.is_error) { exit 13i32; }
+    int64:a = (<-(#ptr_add<int32>(sv, 0i64))) => int64;
+    int64:b = (<-(#ptr_add<int32>(sv, 1i64))) => int64;
+    dalloc(sv);
+
+    // send the read end: one payload byte, one SCM_RIGHTS header
+    wild int8->:blk = calloc(1i64, 128i64);
+    wild MsgHdr->:sm = blk =>! wild MsgHdr->;
+    wild IoVec->:siv = (#ptr_add<int8>(blk, 56i64)) =>! wild IoVec->;
+    wild CmsgFd->:sc = (#ptr_add<int8>(blk, 72i64)) =>! wild CmsgFd->;
+    siv.base = #ptr_add<int8>(blk, 120i64);
+    siv.len = 1u64;
+    sc.len = CMSG_LEN_ONE_FD =>! uint64;
+    sc.level = SOL_SOCKET;
+    sc.ctype = SCM_RIGHTS;
+    sc.passed = pr =>! int32;
+    sm.iov = #ptr_add<int8>(blk, 56i64);
+    sm.iovlen = 1u64;
+    sm.control = #ptr_add<int8>(blk, 72i64);
+    sm.controllen = CMSG_SPACE_ONE_FD =>! uint64;
+    Result<int64>:rsend = sys(SYS_SENDMSG, a, blk, MSG_NOSIGNAL);
+    dalloc(blk);
+    if (rsend.is_error) { exit 14i32; }
+    if (rsend.value != 1i64) { exit 15i32; }
+
+    // receive it, close-on-exec atomically
+    wild int8->:rblk = calloc(1i64, 128i64);
+    wild MsgHdr->:rm = rblk =>! wild MsgHdr->;
+    wild IoVec->:riv = (#ptr_add<int8>(rblk, 56i64)) =>! wild IoVec->;
+    wild CmsgFd->:rc = (#ptr_add<int8>(rblk, 72i64)) =>! wild CmsgFd->;
+    riv.base = #ptr_add<int8>(rblk, 120i64);
+    riv.len = 1u64;
+    rm.iov = #ptr_add<int8>(rblk, 56i64);
+    rm.iovlen = 1u64;
+    rm.control = #ptr_add<int8>(rblk, 72i64);
+    rm.controllen = CMSG_SPACE_ONE_FD =>! uint64;
+    Result<int64>:rrecv = sys(SYS_RECVMSG, b, rblk, MSG_CMSG_CLOEXEC);
+    if (rrecv.is_error) { exit 16i32; }
+    if (rrecv.value != 1i64) { exit 17i32; }
+    if ((rm.flags & 8i64) != 0i64) { exit 18i32; }
+    if ((rm.controllen =>! int64) != CMSG_SPACE_ONE_FD) { exit 19i32; }
+    if ((rc.len =>! int64) != CMSG_LEN_ONE_FD) { exit 20i32; }
+    if (rc.level != SOL_SOCKET) { exit 21i32; }
+    if (rc.ctype != SCM_RIGHTS) { exit 22i32; }
+    int64:got = rc.passed => int64;
+    dalloc(rblk);
+    if (got == pr) { exit 23i32; }
+    if (got < 3i64) { exit 24i32; }
+    Result<int64>:fl = sys(SYS_FCNTL, got, F_GETFD);
+    if (fl.is_error) { exit 25i32; }
+    if ((fl.value & FD_CLOEXEC) == 0i64) { exit 26i32; }
+
+    // the pipe's bytes, through the received descriptor
+    wild int8->:inb = calloc(1i64, 8i64);
+    Result<int64>:rr = sys(SYS_READ, got, inb, 8i64);
+    if (rr.is_error) { exit 27i32; }
+    if (rr.value != 3i64) { exit 28i32; }
+    if ((<-(#ptr_add<uint8>(inb, 2i64))) != 122u8) { exit 29i32; }
+    dalloc(inb);
+    Result<int64>:c1 = sys(SYS_CLOSE, got);
+    Result<int64>:c2 = sys(SYS_CLOSE, pr);
+    Result<int64>:c3 = sys(SYS_CLOSE, pw);
+    Result<int64>:c4 = sys(SYS_CLOSE, a);
+    Result<int64>:c5 = sys(SYS_CLOSE, b);
+    if (c1.is_error) { exit 30i32; }
+    if (c2.is_error) { exit 31i32; }
+    if (c3.is_error) { exit 32i32; }
+    if (c4.is_error) { exit 33i32; }
+    if (c5.is_error) { exit 34i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
