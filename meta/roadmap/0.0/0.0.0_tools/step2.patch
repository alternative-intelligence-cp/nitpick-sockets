diff --git a/tests/probe/probe01_sys_socket.npk b/tests/probe/probe01_sys_socket.npk
new file mode 100644
index 0000000..139b689
--- /dev/null
+++ b/tests/probe/probe01_sys_socket.npk
@@ -0,0 +1,90 @@
+// expect-exit: 0
+//
+// PROBE 01 -- `socket` AND `socketpair` WITH THE ATOMIC FLAGS.
+//
+// ASKS: `sys(41, AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, IPPROTO_TCP)`, the same for an
+// `AF_INET6` datagram socket, and `sys(53, AF_UNIX, SOCK_STREAM | ..., 0, sv)` with an 8-byte `wild`
+// block for the two descriptors. Each descriptor is >= 3, `fcntl(F_GETFL)` reports `O_NONBLOCK`
+// and `fcntl(F_GETFD)` reports `FD_CLOEXEC` -- set by the creating call, with no follow-up `fcntl`.
+// It is also this library's first `sys` call with a pointer argument (D-192's trampoline).
+// DEPENDS ON THE ANSWER: SK-012 (`SAFETY.md` S-18). Refused or unflagged, the fallback -- `socket`
+// then two `fcntl`s -- reopens the `execve` window SK-012 closes.
+// EXPECTED: exit 0 at -O0 and through `opt -O2`. Codes 10 ... 43 are the assertions.
+mod:probe01_sys_socket;
+
+fixed int64:SYS_CLOSE = 3i64;
+fixed int64:SYS_SOCKET = 41i64;
+fixed int64:SYS_SOCKETPAIR = 53i64;
+fixed int64:SYS_FCNTL = 72i64;
+fixed int64:AF_UNIX = 1i64;
+fixed int64:AF_INET = 2i64;
+fixed int64:AF_INET6 = 10i64;
+fixed int64:SOCK_STREAM = 1i64;
+fixed int64:SOCK_DGRAM = 2i64;
+fixed int64:SOCK_NONBLOCK = 2048i64;
+fixed int64:SOCK_CLOEXEC = 524288i64;
+fixed int64:IPPROTO_TCP = 6i64;
+fixed int64:IPPROTO_UDP = 17i64;
+fixed int64:F_GETFD = 1i64;
+fixed int64:F_GETFL = 3i64;
+fixed int64:FD_CLOEXEC = 1i64;
+fixed int64:FL_NONBLOCK = 2048i64;
+
+// 0 when the descriptor is >= 3, non-blocking and close-on-exec; else the first failed check, 1 ... 4.
+func:flagged = int32(int64:descr) never fails {
+    if (descr < 3i64) { pass 1i32; }
+    Result<int64>:fl = sys(SYS_FCNTL, descr, F_GETFL);
+    if (fl.is_error) { pass 2i32; }
+    if ((fl.value & FL_NONBLOCK) == 0i64) { pass 3i32; }
+    Result<int64>:fd_flags = sys(SYS_FCNTL, descr, F_GETFD);
+    if (fd_flags.is_error) { pass 2i32; }
+    if ((fd_flags.value & FD_CLOEXEC) == 0i64) { pass 4i32; }
+    pass 0i32;
+};
+
+func:main = int32(cstring[]:_~argv) {
+    int64:atomic_flags = SOCK_NONBLOCK | SOCK_CLOEXEC;
+    int64:tcp_kind = SOCK_STREAM | atomic_flags;
+    Result<int64>:r4 = sys(SYS_SOCKET, AF_INET, tcp_kind, IPPROTO_TCP);
+    if (r4.is_error) { exit 10i32; }
+    int32:v4 = raw flagged(r4.value);
+    if (v4 != 0i32) { exit 10i32 + v4; }
+    int64:udp_kind = SOCK_DGRAM | atomic_flags;
+    Result<int64>:r6 = sys(SYS_SOCKET, AF_INET6, udp_kind, IPPROTO_UDP);
+    if (r6.is_error) { exit 20i32; }
+    int32:v6 = raw flagged(r6.value);
+    if (v6 != 0i32) { exit 20i32 + v6; }
+    wild int8->:sv = alloc(8i64);
+    Result<int64>:rp = sys(SYS_SOCKETPAIR, AF_UNIX, tcp_kind, 0i64, sv);
+    if (rp.is_error) { exit 30i32; }
+    int64:a = (<-(#ptr_add<int32>(sv, 0i64))) => int64;
+    int64:b = (<-(#ptr_add<int32>(sv, 1i64))) => int64;
+    dalloc(sv);
+    int32:va = raw flagged(a);
+    if (va != 0i32) { exit 30i32 + va; }
+    int32:vb = raw flagged(b);
+    if (vb != 0i32) { exit 35i32 + vb; }
+    Result<int64>:c1 = sys(SYS_CLOSE, r4.value);
+    Result<int64>:c2 = sys(SYS_CLOSE, r6.value);
+    Result<int64>:c3 = sys(SYS_CLOSE, a);
+    Result<int64>:c4 = sys(SYS_CLOSE, b);
+    if (c1.is_error) { exit 40i32; }
+    if (c2.is_error) { exit 41i32; }
+    if (c3.is_error) { exit 42i32; }
+    if (c4.is_error) { exit 43i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/probe/probe02_sockaddr_layout.npk b/tests/probe/probe02_sockaddr_layout.npk
new file mode 100644
index 0000000..0a1165a
--- /dev/null
+++ b/tests/probe/probe02_sockaddr_layout.npk
@@ -0,0 +1,141 @@
+// expect-exit: 0
+//
+// PROBE 02 -- THE `sockaddr` LAYOUTS, THROUGH THE KERNEL.
+//
+// ASKS: `sockaddr_in`, `sockaddr_in6` and `sockaddr_un`, declared as Nitpick structs and laid over a
+// 64- or 128-byte `wild` block whose bytes past the structure hold a sentinel (0x5A): each is
+// filled, `bind`ed on loopback to port 0 (an `AF_UNIX` socket autobinds into the abstract
+// namespace), and read back with `getsockname` -- the length the kernel returns, the family, a
+// non-zero port, the loopback address, and the sentinel untouched. `#size_of` of each struct, and
+// of a 128-byte `sockaddr_storage`, is asserted beside it.
+// DEPENDS ON THE ANSWER: SK-016 and `ADDRESS_MODEL.md` §2's tables (A-4): a size or an offset the
+// kernel disagrees with is a table that is wrong, and the kernel wins.
+// EXPECTED: exit 0 at -O0 and through `opt -O2`. Codes 10 ... 59 are the assertions.
+mod:probe02_sockaddr_layout;
+
+fixed int64:SYS_CLOSE = 3i64;
+fixed int64:SYS_SOCKET = 41i64;
+fixed int64:SYS_BIND = 49i64;
+fixed int64:SYS_GETSOCKNAME = 51i64;
+fixed int64:AF_UNIX = 1i64;
+fixed int64:AF_INET = 2i64;
+fixed int64:AF_INET6 = 10i64;
+fixed int64:SOCK_STREAM = 1i64;
+fixed int64:SOCK_NONBLOCK = 2048i64;
+fixed int64:SOCK_CLOEXEC = 524288i64;
+fixed uint8:SENTINEL = 90u8;
+
+struct:SockaddrIn = { uint16:family; uint16:port_be; uint8[4]:addr; uint8[8]:zero; };
+struct:SockaddrIn6 = { uint16:family; uint16:port_be; uint32:flow_be; uint8[16]:addr; uint32:scope; };
+struct:SockaddrUn = { uint16:family; uint8[108]:path; };
+struct:SockaddrStorage = { uint16:family; uint8[126]:rest; };
+
+// A socket of `family`, bound to what `blk` holds (its first `len` bytes), and read back into `blk`
+// by `getsockname` with room for 64: the length the kernel wrote, or a code below 0.
+func:bind_back = int64(int64:family, wild int8->:blk, int64:len) never fails {
+    int64:kind = (SOCK_STREAM | SOCK_NONBLOCK) | SOCK_CLOEXEC;
+    Result<int64>:rs = sys(SYS_SOCKET, family, kind, 0i64);
+    if (rs.is_error) { pass 0i64 - 1i64; }
+    Result<int64>:rb = sys(SYS_BIND, rs.value, blk, len);
+    if (rb.is_error) {
+        Result<int64>:c0 = sys(SYS_CLOSE, rs.value);
+        if (c0.is_error) { pass 0i64 - 2i64; }
+        pass 0i64 - 2i64;
+    }
+    wild int8->:lenp = calloc(1i64, 8i64);
+    <-(#ptr_add<int32>(lenp, 0i64)) = 64i32;
+    Result<int64>:rg = sys(SYS_GETSOCKNAME, rs.value, blk, lenp);
+    int64:got = (<-(#ptr_add<int32>(lenp, 0i64))) => int64;
+    dalloc(lenp);
+    Result<int64>:c1 = sys(SYS_CLOSE, rs.value);
+    if (rg.is_error) { pass 0i64 - 3i64; }
+    if (c1.is_error) { pass 0i64 - 4i64; }
+    pass got;
+};
+
+// Every byte of `blk` from `from` up to its 64th still holds the sentinel.
+func:untouched = bool(wild int8->:blk, int64:from) never fails {
+    for (int64:k in from...64i64) {
+        if ((<-(#ptr_add<uint8>(blk, k))) != SENTINEL) { pass false; }
+    }
+    pass true;
+};
+
+func:fill = NIL(wild int8->:blk) never fails {
+    for (int64:k in 0i64...64i64) { <-(#ptr_add<uint8>(blk, k)) = SENTINEL; }
+    pass NIL;
+};
+
+func:main = int32(cstring[]:_~argv) {
+    if (#size_of<SockaddrIn>() != 16i64) { exit 10i32; }
+    if (#size_of<SockaddrIn6>() != 28i64) { exit 11i32; }
+    if (#size_of<SockaddrUn>() != 110i64) { exit 12i32; }
+    if (#size_of<SockaddrStorage>() != 128i64) { exit 13i32; }
+
+    // sockaddr_in: 127.0.0.1, port 0
+    wild int8->:b4 = alloc(64i64);
+    drop fill(b4);
+    wild SockaddrIn->:s4 = b4 =>! wild SockaddrIn->;
+    s4.family = 2u16;
+    s4.port_be = 0u16;
+    s4.addr[0i64] = 127u8;
+    s4.addr[1i64] = 0u8;
+    s4.addr[2i64] = 0u8;
+    s4.addr[3i64] = 1u8;
+    for (int64:k in 0i64...8i64) { s4.zero[k] = 0u8; }
+    int64:n4 = raw bind_back(AF_INET, b4, 16i64);
+    if (n4 != 16i64) { exit 20i32; }
+    if (s4.family != 2u16) { exit 21i32; }
+    if (s4.port_be == 0u16) { exit 22i32; }
+    if (s4.addr[0i64] != 127u8) { exit 23i32; }
+    if (s4.addr[3i64] != 1u8) { exit 24i32; }
+    if (!(raw untouched(b4, 16i64))) { exit 25i32; }
+    dalloc(b4);
+
+    // sockaddr_in6: ::1, port 0
+    wild int8->:b6 = alloc(64i64);
+    drop fill(b6);
+    wild SockaddrIn6->:s6 = b6 =>! wild SockaddrIn6->;
+    s6.family = 10u16;
+    s6.port_be = 0u16;
+    s6.flow_be = 0u32;
+    for (int64:k in 0i64...15i64) { s6.addr[k] = 0u8; }
+    s6.addr[15i64] = 1u8;
+    s6.scope = 0u32;
+    int64:n6 = raw bind_back(AF_INET6, b6, 28i64);
+    if (n6 != 28i64) { exit 30i32; }
+    if (s6.family != 10u16) { exit 31i32; }
+    if (s6.port_be == 0u16) { exit 32i32; }
+    if (s6.addr[15i64] != 1u8) { exit 33i32; }
+    if (s6.addr[0i64] != 0u8) { exit 34i32; }
+    if (!(raw untouched(b6, 28i64))) { exit 35i32; }
+    dalloc(b6);
+
+    // sockaddr_un: the family alone, which autobinds a unique abstract name -- 2 + 1 + 5 bytes
+    wild int8->:bu = alloc(64i64);
+    drop fill(bu);
+    wild SockaddrUn->:su = bu =>! wild SockaddrUn->;
+    su.family = 1u16;
+    int64:nu = raw bind_back(AF_UNIX, bu, 2i64);
+    if (nu != 8i64) { exit 40i32; }
+    if (su.family != 1u16) { exit 41i32; }
+    if (su.path[0i64] != 0u8) { exit 42i32; }
+    if (!(raw untouched(bu, 8i64))) { exit 43i32; }
+    dalloc(bu);
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/probe/probe03_cmsg_layout.npk b/tests/probe/probe03_cmsg_layout.npk
new file mode 100644
index 0000000..8f15f2a
--- /dev/null
+++ b/tests/probe/probe03_cmsg_layout.npk
@@ -0,0 +1,107 @@
+// expect-exit: 0
+//
+// PROBE 03 -- `msghdr`, `iovec`, `cmsghdr` AND `ucred`.
+//
+// ASKS: `#size_of` of the Nitpick structs mirroring each kernel structure -- 56, 16, 16 and 12
+// bytes -- and a `sendmsg`/`recvmsg` round trip over a `socketpair` through them, one `iovec` and
+// NO control payload: the bytes arrive whole and `msg_flags` comes back zero. `ucred`'s fields are
+// `cpid`, `cuid` and `cgid`, because `pid`, `uid` and `gid` are keywords at the pin (landing 113:
+// a keyword declared as a name of any kind is `NITPICK-PARSE-001`).
+// DEPENDS ON THE ANSWER: `ANCILLARY_MODEL.md` §1's layouts, and SK-016. The compiler's Bridge
+// (`lib/nbridge.npk`) depends on the same numbers; this measures them independently.
+// EXPECTED: exit 0 at -O0 and through `opt -O2`. Codes 10 ... 29 are the assertions.
+mod:probe03_cmsg_layout;
+
+fixed int64:SYS_CLOSE = 3i64;
+fixed int64:SYS_SENDMSG = 46i64;
+fixed int64:SYS_RECVMSG = 47i64;
+fixed int64:SYS_SOCKETPAIR = 53i64;
+fixed int64:AF_UNIX = 1i64;
+fixed int64:SOCK_STREAM = 1i64;
+fixed int64:SOCK_NONBLOCK = 2048i64;
+fixed int64:SOCK_CLOEXEC = 524288i64;
+fixed int64:MSG_NOSIGNAL = 16384i64;
+
+// `msg_namelen` and `msg_flags` as one 8-byte word each, covering the `int32` and its padding (N-1).
+struct:MsgHdr = {
+    wild int8->:name; int64:namelen;
+    wild int8->:iov; uint64:iovlen;
+    wild int8->:control; uint64:controllen;
+    int64:flags;
+};
+struct:IoVec = { wild int8->:base; uint64:len; };
+struct:CmsgHdr = { uint64:len; int32:level; int32:ctype; };
+struct:Ucred = { int32:cpid; uint32:cuid; uint32:cgid; };
+
+func:main = int32(cstring[]:_~argv) {
+    if (#size_of<MsgHdr>() != 56i64) { exit 10i32; }
+    if (#size_of<IoVec>() != 16i64) { exit 11i32; }
+    if (#size_of<CmsgHdr>() != 16i64) { exit 12i32; }
+    if (#size_of<Ucred>() != 12i64) { exit 13i32; }
+
+    wild int8->:sv = alloc(8i64);
+    int64:kind = (SOCK_STREAM | SOCK_NONBLOCK) | SOCK_CLOEXEC;
+    Result<int64>:rp = sys(SYS_SOCKETPAIR, AF_UNIX, kind, 0i64, sv);
+    if (rp.is_error) { exit 14i32; }
+    int64:a = (<-(#ptr_add<int32>(sv, 0i64))) => int64;
+    int64:b = (<-(#ptr_add<int32>(sv, 1i64))) => int64;
+    dalloc(sv);
+
+    // send five bytes, "hello"
+    wild int8->:out = calloc(1i64, 8i64);
+    <-(#ptr_add<uint8>(out, 0i64)) = 104u8;
+    <-(#ptr_add<uint8>(out, 1i64)) = 101u8;
+    <-(#ptr_add<uint8>(out, 2i64)) = 108u8;
+    <-(#ptr_add<uint8>(out, 3i64)) = 108u8;
+    <-(#ptr_add<uint8>(out, 4i64)) = 111u8;
+    wild int8->:sblk = calloc(1i64, 72i64);
+    wild MsgHdr->:sm = sblk =>! wild MsgHdr->;
+    wild IoVec->:siv = (#ptr_add<int8>(sblk, 56i64)) =>! wild IoVec->;
+    siv.base = out;
+    siv.len = 5u64;
+    sm.iov = #ptr_add<int8>(sblk, 56i64);
+    sm.iovlen = 1u64;
+    Result<int64>:rs = sys(SYS_SENDMSG, a, sblk, MSG_NOSIGNAL);
+    dalloc(sblk);
+    dalloc(out);
+    if (rs.is_error) { exit 15i32; }
+    if (rs.value != 5i64) { exit 16i32; }
+
+    // receive into sixteen, with no room for control
+    wild int8->:inb = calloc(1i64, 16i64);
+    wild int8->:rblk = calloc(1i64, 72i64);
+    wild MsgHdr->:rm = rblk =>! wild MsgHdr->;
+    wild IoVec->:riv = (#ptr_add<int8>(rblk, 56i64)) =>! wild IoVec->;
+    riv.base = inb;
+    riv.len = 16u64;
+    rm.iov = #ptr_add<int8>(rblk, 56i64);
+    rm.iovlen = 1u64;
+    rm.flags = 7i64;
+    Result<int64>:rr = sys(SYS_RECVMSG, b, rblk, 0i64);
+    if (rr.is_error) { exit 17i32; }
+    if (rr.value != 5i64) { exit 18i32; }
+    if (rm.flags != 0i64) { exit 19i32; }
+    if ((<-(#ptr_add<uint8>(inb, 0i64))) != 104u8) { exit 20i32; }
+    if ((<-(#ptr_add<uint8>(inb, 4i64))) != 111u8) { exit 21i32; }
+    if (rm.controllen != 0u64) { exit 22i32; }
+    dalloc(rblk);
+    dalloc(inb);
+    Result<int64>:ca = sys(SYS_CLOSE, a);
+    Result<int64>:cb = sys(SYS_CLOSE, b);
+    if (ca.is_error) { exit 23i32; }
+    if (cb.is_error) { exit 24i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/probe/probe12_pod_addr_array.npk b/tests/probe/probe12_pod_addr_array.npk
new file mode 100644
index 0000000..c09d326
--- /dev/null
+++ b/tests/probe/probe12_pod_addr_array.npk
@@ -0,0 +1,107 @@
+// expect-exit: 32
+//
+// PROBE 12 -- A POD ADDRESS ARRAY.
+//
+// ASKS: `ADDRESS_MODEL.md` §1's address types, declared as written and derived `Copy`, at their
+// MEASURED sizes; then a `Vec`-shaped `wild` array of 4 096 `SocketAddr` values -- filled
+// alternately `V4` and `V6`, read back through a `pick`, copied whole into a second array by
+// value, compared, and freed -- and a generic `T: Copy` read of one (the bound `src/core/`'s
+// `Vec<T: Copy>` will take).
+// DEPENDS ON THE ANSWER: SK-022 (A-1: every address type is a plain value with no owning field,
+// precisely so this works) and `ADDRESS_MODEL.md` §1's declarations. A `#size_of` is measured,
+// never summed (`PLAYBOOK.md` §2).
+// EXPECTED: exit 32 -- `#size_of<SocketAddr>()`, the probe's subject -- at -O0 and through
+// `opt -O2`. Codes 10 ... 29 are the assertions, the other sizes among them: `Ipv4Addr` 4,
+// `Ipv6Addr` 20, `IpAddr` 24, `SocketAddrV4` 6, `SocketAddrV6` 28, `UnixAddr` 110.
+mod:probe12_pod_addr_array;
+
+#[derive(Copy)]
+struct:Ipv4Addr = { uint8[4]:octets; };
+#[derive(Copy)]
+struct:Ipv6Addr = { uint8[16]:octets; uint32:scope; };
+#[derive(Copy)]
+enum:IpAddr = { V4(Ipv4Addr); V6(Ipv6Addr); };
+#[derive(Copy)]
+struct:SocketAddrV4 = { Ipv4Addr:ip; uint16:port; };
+#[derive(Copy)]
+struct:SocketAddrV6 = { Ipv6Addr:ip; uint16:port; uint32:flow; };
+#[derive(Copy)]
+enum:SocketAddr = { V4(SocketAddrV4); V6(SocketAddrV6); };
+#[derive(Copy)]
+struct:UnixAddr = { uint8[108]:path; uint8:len; uint8:kind; };
+
+fixed int64:COUNT = 4096i64;
+
+func:same<T: Copy> = T(T:x) never fails {
+    pass x;
+};
+
+// The address the array holds at `k`: even k a V4 on port k, odd k a V6 on port k with flow k.
+func:addr_at = SocketAddr(int64:k) never fails {
+    uint16:port = (k =>! int32) =>! uint16;
+    if ((k & 1i64) == 0i64) {
+        Ipv4Addr:v4 = Ipv4Addr{ octets: [127u8, 0u8, 0u8, 1u8] };
+        pass SocketAddr.V4(SocketAddrV4{ ip: v4, port: port });
+    }
+    Ipv6Addr:v6 = Ipv6Addr{ octets: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8], scope: 0u32 };
+    pass SocketAddr.V6(SocketAddrV6{ ip: v6, port: port, flow: (k =>! int32) =>! uint32 });
+};
+
+// The port `a` carries, and whether its family is the one `k`'s parity names: the port, or -1.
+func:port_of = int64(SocketAddr:a, int64:k) never fails {
+    pick (a) {
+        (SocketAddr.V4(s)) {
+            if ((k & 1i64) != 0i64) { pass 0i64 - 1i64; }
+            pass s.port => int64;
+        },
+        (SocketAddr.V6(s)) {
+            if ((k & 1i64) == 0i64) { pass 0i64 - 1i64; }
+            if ((s.flow => int64) != k) { pass 0i64 - 1i64; }
+            pass s.port => int64;
+        }
+    }
+};
+
+func:main = int32(cstring[]:_~argv) {
+    if (#size_of<Ipv4Addr>() != 4i64) { exit 10i32; }
+    if (#size_of<Ipv6Addr>() != 20i64) { exit 11i32; }
+    if (#size_of<IpAddr>() != 24i64) { exit 12i32; }
+    if (#size_of<SocketAddrV4>() != 6i64) { exit 13i32; }
+    if (#size_of<SocketAddrV6>() != 28i64) { exit 14i32; }
+    if (#size_of<UnixAddr>() != 110i64) { exit 15i32; }
+
+    int64:width = #size_of<SocketAddr>();
+    wild SocketAddr->:first = (alloc(COUNT * width)) =>! wild SocketAddr->;
+    wild SocketAddr->:second = (alloc(COUNT * width)) =>! wild SocketAddr->;
+    for (int64:k in 0i64...COUNT) {
+        <-(#ptr_add<SocketAddr>(first, k)) = raw addr_at(k);
+    }
+    for (int64:k in 0i64...COUNT) {
+        SocketAddr:one = <-(#ptr_add<SocketAddr>(first, k));
+        SocketAddr:copy = one;
+        <-(#ptr_add<SocketAddr>(second, k)) = copy;
+        if ((raw port_of(one, k)) != k) { exit 16i32; }
+    }
+    for (int64:k in 0i64...COUNT) {
+        SocketAddr:back = raw same(<-(#ptr_add<SocketAddr>(second, k)));
+        if ((raw port_of(back, k)) != k) { exit 17i32; }
+    }
+    dalloc(first);
+    dalloc(second);
+    exit (width =>! int32);
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
