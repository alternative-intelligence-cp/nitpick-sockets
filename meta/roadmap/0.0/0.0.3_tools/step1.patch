+def run(ctx, root, floor_bin, floor_edges, say):
+    got = cases(ctx, root, floor_bin, floor_edges)
+    for name, caught, said, passed, csaid in got:
+        ok = caught and passed
+        say(f"{'ok  ' if ok else 'FAIL'}  selfcheck {name}: "
+            + (f"caught -- {said[:150]}" if caught else f"NOT CAUGHT -- {said[:150]}")
+            + ("" if passed else f"; ITS CONTROL FAILED -- {csaid[:150]}"))
+    for name, when in PENDING:
+        say(f"PEND  selfcheck {name}: pending until {when}")
+    good = sum(1 for _, c, _, p, _ in got if c and p)
+    return good == len(got), (f"the self-check: {good} of {len(got)} live cases caught, each beside its control; "
+                              f"{len(PENDING)} pending")
