+def _files(root, top, ext=".npk"):
+    out = []
+    for d, dirs, fs in os.walk(os.path.join(root, top)):
+        dirs.sort()
+        out += [os.path.join(d, f) for f in sorted(fs) if f.endswith(ext)]
+    return out
+
+
+def _text(path):
+    """A document -- a specification, a README, a Python file -- as the UTF-8 text it is: its `—` and `§` are one
+    character each. `.npk` source is read through `lexical.read()`, never this."""
+    with open(path, encoding="utf-8", errors="replace") as fh:
+        return fh.read()
+
+
+def _spec(root, name):
+    return _text(os.path.join(root, SPECS, name))
