+                           f"{_int(m.group(2))} -- a test binds port 0 and reads the port back (V-3)")
+    return (f"check_no_hardcoded_port: {len(files)} file(s) under tests/, {n} port binding(s) by a literal, "
+            f"each 0 unless named below"), bad
+
+
