+
+def _prose(path):
+    """A file's words, comments and docstrings included: a `.npk` file through `lexical.read()`, its bytes taken as the
+    UTF-8 its comments are written in; any other file as UTF-8 text."""
+    return read(path).encode("latin-1").decode("utf-8", errors="replace") if path.endswith(".npk") else _text(path)
+
+
+def check_specs_current(root):
+    specs = {f for f in os.listdir(os.path.join(root, SPECS)) if f.endswith(".md")}
+    rules, secs = {}, {}
+    for f in specs:
+        t = _spec(root, f)
+        rules[f] = set(re.findall(r"\*\*Rule ([A-Z]-\d+[a-z]?(?:\.\d+)?)\b", t))
+        secs[f] = set(re.findall(r"^## (\d+)\.", t, re.M))
+    paths = [p for top in ("src", "tests", "harness") for ext in (".npk", ".py", ".md") for p in _files(root, top, ext)]
+    ours, outside, gone = 0, 0, []
+    pat = re.compile(r"`?([A-Z_]+\.md)`?\s+(§(\d+)|([A-Z]-\d+[a-z]?)\b)")
+    for p in paths:
+        for m in pat.finditer(_prose(p)):
+            doc = m.group(1)
+            if doc not in specs:
+                outside += 1
+                continue
+            ours += 1
+            if m.group(3) and m.group(3) not in secs[doc]:
+                gone.append(f"{_rel(root, p)}: `{doc}` §{m.group(3)} -- that specification has no such section")
+            if m.group(4) and m.group(4) not in rules[doc]:
+                gone.append(f"{_rel(root, p)}: `{doc}` {m.group(4)} -- that specification defines no such rule")
+    return (f"check_specs_current: {len(paths)} file(s) under src/, tests/ and harness/; {ours} citation(s) of this "
+            f"repository's specifications, each resolved; {outside} of another repository's documents, read there"), gone
+
+
+ALL = [check_layering, check_error_budget, check_constants_named, check_no_hardcoded_port, check_msg_nosignal,
+       check_no_floor_write, check_no_raw_setsockopt, check_struct_sizes, check_specs_current]
