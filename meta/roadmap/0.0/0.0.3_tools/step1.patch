+        unjudged.tests[0].pop("kind", None)
+        why = manifest.refusal(unjudged, stages.JUDGED)
+        self.add("stage-unjudged", bool(why) and "`cost`" in (why or ""), why or "honoured", cpass, csaid)
+        unswept = copy.deepcopy(man)
