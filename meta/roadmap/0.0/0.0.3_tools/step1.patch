+    # ---- the tree checks: a scratch tree holding the specifications each reads, and the planted files ----
+
+    def tree(self, case, check, files, want, control_files, specs=True, exact=False):
+        def make(base, fs):
+            shutil.rmtree(base, ignore_errors=True)
+            os.makedirs(os.path.join(base, "meta", "specs"))
+            for f in os.listdir(os.path.join(self.root, "meta", "specs")) if specs else ():
+                if f.endswith(".md"):
+                    shutil.copy2(os.path.join(self.root, "meta", "specs", f), os.path.join(base, "meta", "specs", f))
+            for rel, text in fs.items():
+                _write(os.path.join(base, rel), text)
+            return base
+        _, bad = check(make(os.path.join(self.w, case), files))
+        hit = [b for b in bad if want in b] if (len(bad) == 1 or not exact) else []
+        _, cbad = check(make(os.path.join(self.w, case + "-control"), control_files))
+        self.add(case, bool(hit), hit[0] if hit else ("; ".join(bad) or "no finding"), not cbad,
+                 "; ".join(cbad) or "no finding")
