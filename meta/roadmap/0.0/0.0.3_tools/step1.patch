+#!/usr/bin/env python3
+"""The self-check -- the harness handed faults and required to CATCH each one, beside a control it must pass
+(`meta/specs/TESTING.md` V-14, V-15; `BUILD.md` B-9; @@PD-174@@). It runs in every full run after the first build
+step, whose floor program its cases are built on, and before anything judges the library: if a live case is not
+caught, or a control is not passed, the run stops there, RED -- a suite that only ever agrees with what it is handed
+reports green while checking nothing.
+
+A case that needs a fixture writes it under `build/harness/selfcheck/`, and every case hands its fault to the SAME
+functions the run uses -- `stages.Stage`, `build`, `irscan`, `toolchain`, `manifest.refusal`, `lexical` and
+`treecheck.*` -- never a copy of their logic. A case is CAUGHT when the function's verdict names its fault: a `FAIL`
+verdict, a `SKIP` verdict saying why, a finding, or a refusal, with the words the case names. Each carries its CONTROL
+in the same run -- the same function handed the case without its fault, which it must pass; for the call-edge scan's
+cases, one module of the library's own facets -- since a fault caught by a function that fails everything proves
+nothing. A PENDING case is printed as pending, with the cycle that makes it live, and never counts
+as caught. The fixtures' codes, exits and sites are the pin's, measured by the plan that wrote this file.
+"""
+import copy
+import os
+import shutil
+import socket
+import subprocess
+
+import build
+import expect  # noqa: F401 -- read by the stages the cases run
+import irscan
+import lexical
+import manifest
+import stages
+import toolchain
+import treecheck
+
+FLOOR = '''func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
+'''
+MAIN0 = "func:main = int32(cstring[]:_~argv) {\n    exit 0i32;\n};\n"
+PLAIN_BINDING = "int64:COUNTER = 0i64;\n\n" + MAIN0           # NITPICK-TYPE-055 at its line, column 1
+TWO_CODES = ("int64:COUNTER = 0i64;\n\nfunc:main = int32(cstring[]:_~argv) {\n    string:s = string_concat(\"ab\", \"c\");\n"
+             "    uint8[]:p = string_bytes(s);\n    exit 0i32;\n};\n")  # TYPE-055 at 3:1 and TYPE-007 at 7:5, from `mod:`
+NO_PARSE = "func:main = int32(cstring[]:_~argv) {\n    exit 0i32\n};\n"   # NITPICK-PARSE-001
+PENDING = [("check_failsafe_arms-planted", "cycle 0.2, the first module that raises an identity, when the check's "
+            "input exists")]
+
+# The library's own facets, which the call-edge scan must leave unflagged (`BUILD.md` B-2a), and one module per denied
+# facet, each a construct the scan must flag -- the shapes cycle 0.0.2's mutants measured at the pin.
+LIB_SHAPES = ("pub async func:core_wait = NIL(int32:descr) {\n    Result<NIL>:w = await io_ready(descr, 1i32, "
+              "raw duration_ms(1000i64));\n    if (w.is_error) { fail w.err; }\n    pass NIL;\n};\n\n"
+              "pub func:core_pid = int64() {\n    Result<int64>:r = sys(39i64);\n    if (r.is_error) { pass 0i64; }\n"
+              "    pass r.value;\n};\n")
+DENIED = [
+    ("scan-floor-write", "the floor's write", "pub func:core_write = int64() {\n    wild int8->:none = calloc(1i64, 8i64);\n"
+     "    Result<int64>:r = write((1i32) =>! fd, none, 0i64);\n    dalloc(none);\n    if (r.is_error) { pass 0i64; }\n"
+     "    pass r.value;\n};\n"),
+    ("scan-byte-writer", "the floor's write", "pub async func:core_send = int64(int64:descr, fixed uint8[]:wire) {\n"
+     "    ByteWriter:w = ByteWriter{ sink: own_fd((descr =>! int32) =>! fd) };\n"
+     "    int64:n = await w.write(wire, raw duration_ms(100i64)) ?! Unreachable;\n    pass n;\n};\n"),
+    ("scan-floor-close", "a file, or a descriptor outside K-1", "pub func:core_close = int64() {\n"
+     "    Result<NIL>:r = close((3i32) =>! fd);\n    if (r.is_error) { pass 1i64; }\n    pass 0i64;\n};\n"),
+    ("scan-file", "a file, or a descriptor outside K-1", "pub func:core_path = bool(cstring:path) {\n"
+     "    pass path_exists(path);\n};\n"),
+    ("scan-process", "a process", "pub func:core_retire = int64(int64:slot) {\n    driver_retire(slot);\n    pass 0i64;\n};\n"),
+    ("scan-thread", "a thread", "fixed Duration:JOIN_5S = Duration{ ns: 5000000000i64 };\n\n"
+     "thread async func:core_slow = NIL(int32:_~v) joins JOIN_5S {\n    pass NIL;\n};\n\n"
+     "pub async func:core_spawn = NIL() {\n    drop core_slow(1i32);\n    pass NIL;\n};\n"),
+    ("scan-lock", "a lock", "pub async func:core_lock = NIL() {\n    Mutex<int32, 3i32>:m = mutex(0i32) ?! Unreachable;\n"
+     "    Guard<int32>:g = await m.acquire(raw duration_ms(10i64)) ?! Unreachable;\n    pass NIL;\n};\n"),
+    ("scan-channel", "a channel", "pub func:core_chan = int32() {\n"
+     "    Channel<int32, 3i32, 4i64>:ch = channel() ?! Unreachable;\n    pass 0i32;\n};\n"),
+    ("scan-machine-code", "machine code", "pub func:core_jit = int64() {\n    wildx int8->:p = wildx_alloc(4096i64);\n"
+     "    pass 0i64;\n};\n"),
+    ("scan-environment", "the environment", "pub func:core_env = int64() {\n    cstring[]:e = environ();\n    pass e.len;\n};\n"),
+]
+
+
+class _Quiet(stages.Stage):
+    def _say(self, verdict, suite, rel, detail):
+        self.verdicts.append((verdict, suite, rel, detail.replace(self.root + os.sep + "." + os.sep, "")
+                              .replace(self.root + os.sep, "")))
+
+
+def _write(path, text):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8", newline="") as fh:
+        fh.write(text)
+    return path
+
+
+def _verdict(st, rel_root, entry):
+    st.suite(entry)
+    v = st.verdicts[-1] if st.verdicts else ("NONE", "", "", "no verdict")
+    return v[0], v[3]
+
+
+class Cases:
+    def __init__(self, ctx, root, floor_bin, floor_edges):
+        self.ctx, self.root, self.floor_bin, self.floor_edges = ctx, root, floor_bin, floor_edges
+        self.w = os.path.join(ctx.work, "selfcheck")
+        shutil.rmtree(self.w, ignore_errors=True)
+        self.out = []
+
+    def add(self, name, caught, said, passed, csaid):
+        self.out.append((name, caught, said, passed, csaid))
+
+    # ---- the stages: one unit in a scratch directory, judged by the stage's own function ----
+
+    def unit(self, case, header, body, stage="program", kind=None, network=None, addrs=None):
+        d = os.path.join(self.w, case)
+        name = case.replace("-", "_")
+        _write(os.path.join(d, name + ".npk"), header + f"mod:{name};\n\n" + body + "\n" + FLOOR)
+        st = _Quiet(d, self.ctx, self.floor_bin, None, network)
+        if addrs is not None:
+            st.loopback_addrs = addrs
+        entry = {"name": "selfcheck", "stage": stage, "path": "."}
+        if kind:
+            entry["kind"] = kind
+        return _verdict(st, d, entry)
+
+    def stage_case(self, name, fault, want, control, verdict="FAIL", both=None, fault_kw=None, control_kw=None):
+        v, said = self.unit(name, *fault, **(both or {}), **(fault_kw or {}))
+        cv, csaid = self.unit(name + "-control", *control, **(both or {}), **(control_kw or {}))
+        self.add(name, v == verdict and want in said, said, cv == "PASS", csaid)
+
+    def sweep_case(self):
+        d = os.path.join(self.w, "parse-not-parsing")
+        _write(os.path.join(d, "noparse.npk"), "mod:noparse;\n\n" + NO_PARSE + "\n" + FLOOR)
+        st = _Quiet(d, self.ctx, self.floor_bin)
+        v, said = _verdict(st, d, {"name": "selfcheck", "stage": "parse", "path": ".", "recursive": True})
+        c = os.path.join(self.w, "parse-not-parsing-control")
+        _write(os.path.join(c, "fine.npk"), "mod:fine;\n\n" + MAIN0 + "\n" + FLOOR)
+        _write(os.path.join(c, "refused", "plain_binding.npk"), "mod:plain_binding;\n\n" + PLAIN_BINDING + "\n" + FLOOR)
+        cst = _Quiet(c, self.ctx, self.floor_bin)
+        cv, csaid = _verdict(cst, c, {"name": "selfcheck", "stage": "parse", "path": ".", "recursive": True})
+        self.add("parse-not-parsing", v == "FAIL" and "NITPICK-PARSE-001" in said, said, cv == "PASS", csaid)
+
+    # ---- the build steps: the call-edge scan and B-2's allowance ----
+
+    def scan(self, case, body):
+        d = os.path.join(self.w, case, "src", "core")
+        src = _write(os.path.join(d, "core.npk"), "mod:core;\n\n" + body)
+        rc, codes, text = build.npkc(self.ctx, src, os.path.join(d, "core.ll"))
+        if rc != 0:
+            return None, f"npkc exit {rc}: " + " ".join(c for c, _, _ in codes)
+        with open(os.path.join(d, "core.ll"), encoding="utf-8", errors="replace") as fh:
+            return irscan.findings(fh.read(), self.floor_edges, "src/core/core.npk"), ""
+
+    def scan_cases(self):
+        clean, why = self.scan("scan-control", LIB_SHAPES)
+        cpass = clean == []
+        csaid = "the library's own facets, a wait through io_ready and a sys call: " + (
+            "no finding" if cpass else (why or "; ".join(clean)))
+        for case, facet, body in DENIED:
+            found, why = self.scan(case, body)
+            hit = [f for f in (found or []) if f" -- {facet}" in f]
+            self.add(case, bool(hit), hit[0] if hit else (why or "no finding"), cpass, csaid)
+
+    def failsafe_case(self):
+        d = os.path.join(self.w, "failsafe-allowance")
+        src = _write(os.path.join(d, "waits.npk"), "mod:waits;\n\n" + LIB_SHAPES.split("\n\npub func:core_pid")[0] + "\n")
+        rc, _, _ = build.npkc(self.ctx, src, os.path.join(d, "waits.ll"))
+        r = build._run(["llc", *self.ctx.llc_flags, os.path.join(d, "waits.ll"), "-o", os.path.join(d, "waits.o")])
+        if rc != 0 or r[0] != 0:
+            self.add("failsafe-allowance", False, f"the fixture did not build: npkc {rc}, llc {r[0]}", False, "")
+            return
+        as_program = build.undefined_problems(self.ctx, os.path.join(d, "waits.o"), "waits.o", library=False)
+        as_module = build.undefined_problems(self.ctx, os.path.join(d, "waits.o"), "waits.o", library=True)
+        self.add("failsafe-allowance", bool(as_program) and "npk_failsafe" in as_program[0],
+                 as_program[0] if as_program else "no finding", not as_module,
+                 "the same object as a module under src/: " + ("no finding" if not as_module else as_module[0]))
+
+    def undefined_case(self):
+        obj = self.floor_bin + ".o"
+        lacking = copy.copy(self.ctx)
