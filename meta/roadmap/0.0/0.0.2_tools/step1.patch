+// expect-exit: 0
+//
+// THE FLOOR-WRITER -- the floor program and one call of the floor's `write`, of no bytes, from a
+// string's read-only view, to standard output: build step 1 requires its object to differ from the
+// floor's by `npk_write` alone -- so it allocates nothing -- and the call-edge scan to flag
+// `main`'s edge to it -- `SAFETY.md` S-2, the rule most likely to be broken by accident -- on every
+// full run, so a scan gone blind reddens the run instead of passing everything (`PLAYBOOK.md`:
+// measure the instrument before adopting it).
+mod:floorwriter;
+
+func:main = int32(cstring[]:_~argv) {
+    string:s = "x";
+    fixed uint8[]:b = string_bytes(s);
+    Result<int64>:r = write((1i32) =>! fd, b.ptr, 0i64);
+    if (r.is_error) { exit 70i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
