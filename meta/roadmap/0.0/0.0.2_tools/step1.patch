new file mode 100644
index 0000000..58b2799
--- /dev/null
+++ b/harness/irscan.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""The emitted IR's CALL EDGES to the runtime -- `BUILD.md` B-2a (@@PD-170@@): the instrument that
+holds the library to the runtime facets its rules give it, and to none they deny.
+
+WHY CALL EDGES. An undefined-symbol scan reports THAT an object needs a runtime symbol and
+never WHERE it is called from; and at an earlier compiler every syscall went through one
+symbol the empty program already carried, so a program that made one had the same symbol set
+as one that did not (`PLAYBOOK.md`: "the undefined-symbol scan ... CANNOT SEE A SYSCALL").
+After `nitpick-parse`'s `harness/irscan.py`, whose measured lessons (the intrinsics, the glue's
+numbering, a deny list rather than a permit list, the runtime classed whole) this keeps.
+
+WHAT IT SCANS. Every `(enclosing function, callee)` edge in a module's -O0 IR whose callee is
+DECLARED and not DEFINED in the module, `llvm.*` excluded (an intrinsic is an instruction,
+never a symbol), the trailing `.<digits>` of compiler-generated glue normalised away (the
+counter moves with program content). An edge the floor program does not have, to a DENIED
+symbol, is a finding that names the calling function, the facet and the rule. `run.py` reads
+every module under `src/` this way, each compiled as a root on its own; it does not read the
+probes and the tests, which reach the kernel, the floor's `write` and the rest on purpose
+(`tests/probe/README.md`).
+
+THE DENY LIST IS GENERATED FROM ONE TABLE: `runtime_symbols.tsv` beside this file classes every
+global symbol the pinned runtime object defines -- all a module's call can resolve to, since a
+call to a local one does not link -- in exactly one class: `deny: <facet> (<rule>)`, by the
+rule of this library's specifications that forbids it; `library: <facet> (<rule>)`, a facet a
+rule gives the library -- the kernel through `sys` (K-1), the reactor (C-1, C-4), a
+descriptor's drop (SK-011), tasks and their scope's join (C-6, C-8, C-9) and the clock under a
+deadline; or `floor: <family>`, the language's own machinery any program reaches. `run.py`
+holds the table to the runtime object on every run: a global symbol no row names, or a row the
+runtime does not define, stops it, so a re-pin that adds or renames a runtime function is
+classed before a run can be green again.
+
+WHAT IT CANNOT SEE: a facet whose construct lowers to no runtime call of that facet -- a lock made
+and never held calls only the floor's managed allocator and trap route (cycle 0.0.2's §1.6) -- which syscall a
+`sys` call makes (K-1's numbers are `check_constants_named`'s, cycle 0.0.3), what an allowed
+function does inside the runtime, and a generic function no module root instantiates, which is
+not emitted at all. A call-edge scan says nothing of those; review and the tree checks do.
+"""
+import os
+import re
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+TABLE = os.path.join(HERE, "runtime_symbols.tsv")
+
+
+def _load():
+    classes = {}
+    with open(TABLE, encoding="utf-8") as fh:
+        for n, line in enumerate(fh, 1):
+            if not line.strip() or line.startswith("#"):
+                continue
+            cols = line.rstrip("\n").split("\t")
+            if len(cols) != 3 or not re.match(r"^(deny|library|floor): \S", cols[1]):
+                raise ValueError(f"harness/runtime_symbols.tsv:{n}: not `symbol<TAB>deny|library|floor: "
+                                 f"<facet><TAB>why`: {line.strip()!r}")
+            if cols[0] in classes:
+                raise ValueError(f"harness/runtime_symbols.tsv:{n}: `{cols[0]}` is classed twice")
+            classes[cols[0]] = (cols[1], cols[2])
+    return classes
+
+
+CLASSES = _load()
+DENIED = frozenset(n for n, (c, _) in CLASSES.items() if c.startswith("deny: "))
+CLASSED = frozenset(CLASSES)
+
+_SYM = r'@(?:"([^"]*)"|([\w.$\-]+))'
+_DEFINE = re.compile(r'^\s*define\b.*?' + _SYM + r'\s*\(')
+_DECLARE = re.compile(r'^\s*declare\b.*?' + _SYM + r'\s*\(')
+_CALL = re.compile(r'\b(?:call|invoke)\b.*?' + _SYM + r'\s*\(')
+_GENERATED = re.compile(r'\.\d+$')
+
+
+def _name(m):
+    return m.group(1) if m.group(1) is not None else m.group(2)
+
+
+def edges(ir_text):
+    """{(normalised function, callee)} for every call to a symbol the module declares and does not define."""
+    lines = ir_text.split("\n")
+    defined, declared = set(), set()
+    for line in lines:
+        m = _DEFINE.match(line)
+        if m:
+            defined.add(_name(m))
+            continue
+        m = _DECLARE.match(line)
+        if m:
+            declared.add(_name(m))
+    outside = {s for s in declared - defined if not s.startswith("llvm.")}
+    out, cur = set(), None
+    for line in lines:
+        m = _DEFINE.match(line)
+        if m:
+            cur = _name(m)
+            continue
+        if line.startswith("}"):
+            cur = None
+            continue
+        if cur is None:
+            continue
+        m = _CALL.search(line)
+        if m and _name(m) in outside:
+            out.add((_GENERATED.sub(".N", cur), _name(m)))
+    return out
+
+
+def findings(ir_text, baseline, name):
+    """One line per denied edge the floor program does not have, naming the function, the facet and the rule."""
+    return [f"{name}: `{fn}` calls `{callee}`, and the floor program does not -- {CLASSES[callee][0][6:]}: "
+            f"{CLASSES[callee][1]}; a legitimate call is a decision, not an edit here"
+            for fn, callee in sorted(edges(ir_text) - baseline) if callee in DENIED]
