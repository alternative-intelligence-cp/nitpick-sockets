+++ b/harness/stages.py
@@ -0,0 +1,149 @@
+#!/usr/bin/env python3
+"""The stages this runner judges at cycle 0.0.2 -- `program`, `compile`/`positive` and
+`compile`/`negative` (`meta/specs/BUILD.md` §3, B-3, B-6 … B-8; @@PD-171@@).
+
+A UNIT is every `.npk` file directly in an entry's `path` (or each of its `paths`; below them
+too with `recursive = true`), in name order. Nothing is skipped: a suite's directory holds its
+units only, and a file with no `main` fails at the link, by name.
+
+`program` AND `compile`/`positive`: every unit is a program, built by `build.py` at both legs and
+RUN `stress` times on each, and it PASSES when every run exits with its `expect-exit:`.
+`compile`/`positive` -- "compiles, links, runs, and exits with the expected code" -- is judged the
+same way, the optimised leg included, because B-3 runs that leg on every program.
+
+`compile`/`negative`, THE EXACT-CODE RULE (B-7, B-8): `npkc` must exit 1 -- exactly 1, since 2
+judged nothing and 0 accepted it -- and its diagnostics must EQUAL the unit's `expect-error:`
+markers: every reported code matched by one marker, at its `expect-error-at:` place where the
+unit gives one, and every marker by one reported code. A negative unit with no `expect-error:`
+fails, and so does one carrying a marker only a program can mean.
+
+A CAPPED UNIT (`mem-cap-mib: N`) runs under an N MiB address-space cap, and the floor program
+runs under the identical cap first and must exit 0: a cap so low that a program allocating
+nothing fails it measures the loader, not the unit (`PLAYBOOK.md` §9).
+"""
+import os
+import resource
+import subprocess
+
+import build
+import expect
+
+RUN_TIMEOUT = 600
+PROGRAM_ONLY = ("expect-exit:", "stress:", "mem-cap-mib:")
+
+
+def _units(root, entry):
+    out = []
+    for rel in (entry["paths"] if "paths" in entry else [entry["path"]]):
+        top = os.path.join(root, rel)
+        if not os.path.isdir(top):
+            raise FileNotFoundError(f"[[test]] {entry['name']}: `{rel}` is not a directory")
+        if entry.get("recursive"):
+            for d, _, fs in sorted(os.walk(top)):
+                out += [os.path.join(d, f) for f in sorted(fs) if f.endswith(".npk")]
+        else:
+            out += [os.path.join(top, f) for f in sorted(os.listdir(top))
+                    if f.endswith(".npk") and os.path.isfile(os.path.join(top, f))]
+    return out
+
+
+def _cap(mib):
+    def limit():
+        resource.setrlimit(resource.RLIMIT_AS, (mib << 20, mib << 20))
+    return limit
+
+
+def run_binary(path, mib=None):
+    try:
+        r = subprocess.run([path], capture_output=True, timeout=RUN_TIMEOUT,
+                           preexec_fn=_cap(mib) if mib else None)
+        return r.returncode
+    except subprocess.TimeoutExpired:
+        return None
+
+
+class Stage:
+    def __init__(self, root, ctx, floor_binary):
+        self.root, self.ctx, self.floor = root, ctx, floor_binary
+        self.floor_under = {}
+        self.verdicts = []          # (PASS|FAIL, suite, relpath, detail)
+
+    def _say(self, verdict, suite, rel, detail):
+        detail = detail.replace(self.root + os.sep, "")
+        self.verdicts.append((verdict, suite, rel, detail))
+        print(f"{verdict} {suite}/{os.path.basename(rel)}: {detail}", flush=True)
+
+    def suite(self, entry):
+        negative = entry["stage"] == "compile" and entry.get("kind") == "negative"
+        for src in _units(self.root, entry):
+            rel = os.path.relpath(src, self.root)
+            (self._negative if negative else self._program)(entry["name"], src, rel)
+
+    def _program(self, suite, src, rel):
+        e = expect.read(src)
+        if not e.readable:
+            return self._say("FAIL", suite, rel, "UNREADABLE -- " + "; ".join(e.problems))
+        if e.errors:
+            return self._say("FAIL", suite, rel, "carries `expect-error:`, which a program "
+                                                 "stage cannot judge")
+        stem = os.path.join(self.ctx.work, suite, os.path.splitext(os.path.basename(src))[0])
+        b = build.program(self.ctx, src, stem)
+        if b.npkc_exit != 0:
+            return self._say("FAIL", suite, rel, build.npkc_failure(b.npkc_exit, b.codes))
+        stopped = [leg for leg in b.legs if leg.stop]
+        if stopped:
+            return self._say("FAIL", suite, rel, "; ".join(f"{leg.name} {leg.stop}" for leg in stopped))
+        pre = ""
+        if e.mem_cap_mib:
+            if not self._floor_ok(e.mem_cap_mib):
+                return self._say("FAIL", suite, rel, f"under {e.mem_cap_mib} MiB the floor program exits "
+                                                     f"{self.floor_under[e.mem_cap_mib]}: the cap measures the loader")
+            pre = f"under {e.mem_cap_mib} MiB, after the floor program under it; "
+        exits = {leg.name: [run_binary(leg.binary, e.mem_cap_mib) for _ in range(e.stress)] for leg in b.legs}
+        shown = ", ".join(f"{k} {self._show(v)}" for k, v in exits.items())
+        if all(x == e.exit for v in exits.values() for x in v):
+            return self._say("PASS", suite, rel, pre + shown)
+        return self._say("FAIL", suite, rel, f"expected exit {e.exit}; {pre}{shown}")
+
+    def _negative(self, suite, src, rel):
+        e = expect.read(src)
+        if not e.readable:
+            return self._say("FAIL", suite, rel, "UNREADABLE -- " + "; ".join(e.problems))
+        meant = [m for m in PROGRAM_ONLY if m in e.given]
+        if meant:
+            return self._say("FAIL", suite, rel, f"carries `{meant[0]}`, which only a program can mean")
+        if not e.errors:
+            return self._say("FAIL", suite, rel, "a negative unit with no `expect-error:` is a failing "
+                                                 "test (B-8)")
+        out_ll = os.path.join(self.ctx.work, suite, os.path.splitext(os.path.basename(src))[0] + ".ll")
+        os.makedirs(os.path.dirname(out_ll), exist_ok=True)
+        rc, codes, _ = build.npkc(self.ctx, src, out_ll)
+        got = " ".join(f"{c} {l}:{k}" for c, l, k in codes)
+        if rc != 1:
+            why = "accepted it" if rc == 0 else build.npkc_failure(rc, codes)
+            return self._say("FAIL", suite, rel, f"npkc exit {rc} -- {why}; a refusal is exit 1")
+        left = list(codes)
+        missing = []
+        for code, line, col in e.errors:
+            hit = next((d for d in left if d[0] == code and (line is None or d[1] == line)
+                        and (col is None or d[2] == col)), None)
+            if hit is None:
+                missing.append(code + (f" at {line}" if line is not None else "")
+                               + (f":{col}" if col is not None else ""))
+            else:
+                left.remove(hit)
+        if missing or left:
+            parts = ([f"missing {', '.join(missing)}"] if missing else []) + \
+                    ([f"unexpected {', '.join(f'{c} {l}:{k}' for c, l, k in left)}"] if left else [])
+            return self._say("FAIL", suite, rel, f"npkc 1 -- {got}; " + "; ".join(parts) + " (B-8)")
+        return self._say("PASS", suite, rel, f"npkc 1 -- {got}")
+
+    def _floor_ok(self, mib):
+        if mib not in self.floor_under:
+            self.floor_under[mib] = run_binary(self.floor, mib)
+        return self.floor_under[mib] == 0
+
+    @staticmethod
+    def _show(v):
+        v = ["hang" if x is None else str(x) for x in v]
+        return v[0] if len(v) == 1 else (f"{v[0]} x{len(v)}" if len(set(v)) == 1 else "/".join(v))
