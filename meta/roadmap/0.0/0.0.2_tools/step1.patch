+             "honours 0 only")
+
+
+def baseline(ctx, irscan, failures):
+    """The scans' controls: the floor program, the syscaller and the floor-writer, each built and
+    run, and what each scan sees of them against the floor."""
+    got = {}
+    for name in ("floor", "syscaller", "floorwriter"):
+        b = build.program(ctx, os.path.join(ROOT, "harness", "baseline", f"{name}.npk"),
+                          os.path.join(ctx.work, "baseline", name))
+        if b.npkc_exit != 0 or any(leg.stop for leg in b.legs):
