index 0000000..099b049
--- /dev/null
+++ b/harness/expect.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""A test's expectations, read from the test file -- `meta/specs/BUILD.md` B-6 and B-6a.
+
+THE COMPILER'S GRAMMAR, as `npkg/expect.npk` reads it at the pin `c9baa9e`: a line whose
+stripped form starts with `//` is a comment; its body, stripped, is a MARKER when it starts
+with a marker's name -- `// see expect-exit: 94` is prose -- and the marker's value is the
+WHOLE rest of the line, so `// expect-exit: 94 -- the OutOfBounds arm` cannot be read, and a
+test whose expectations cannot be read is a FAILING test, never a silently defaulted one.
+`expect-exit:` -- the last one wins, 0 when absent; `stress:` -- 1 when absent;
+`expect-error-at: L[:C]` moves the LAST `expect-error:`. (After `nitpick-parse`'s
+`harness/expect.py`, which holds the same grammar to the same reader.)
+
+THE MARKERS THE COMPILER'S READER HAS AND THIS RUNNER DOES NOT JUDGE YET -- `expect-note:`,
+`expect-note-at:`, `argv:`, `npkc-flags:`, `expect-no-parse-error`, `explore:`, `explore-seed:`
+and `expect-obligation:` -- each make a file UNREADABLE, by name: a marker a runner ignores is
+an expectation nobody checks. So does `expect-signal:`, which this library's first plan meant
+to add and @@PD-159@@ retired: nothing in the suite is expected to die by a signal, and a file that
+says otherwise is refused rather than read as an exit.
+
+THE RUNNER'S OWN MARKER (B-6a, @@PD-171@@), which `npkg` does not have: `mem-cap-mib: N` -- run
+the program under an N MiB address-space cap, after the floor program under the same cap
+(`stages.py`), because what a managed body leaks is invisible to `exit 0`: D-151 sees `wild`
+allocations alone (cycle 0.0.0's §1.3).
+"""
+import re
+
+MARKERS_JUDGED = ("expect-error-at:", "expect-error:", "expect-exit:", "stress:", "mem-cap-mib:")
+MARKERS_REFUSED = ("expect-note-at:", "expect-note:", "argv:", "npkc-flags:", "expect-no-parse-error",
+                   "explore-seed:", "explore:", "expect-obligation:", "expect-signal:")
+_CODE = re.compile(r"^NITPICK-[A-Z]+-[0-9]{3}$")
+_AT = re.compile(r"^([0-9]+)(?::([0-9]+))?$")
+_INT = re.compile(r"^-?[0-9]+$")
+
+
+class Expect:
+    def __init__(self, path):
+        self.path = path
+        self.exit = 0
+        self.given = set()        # the judged markers the file carries
+        self.errors = []          # [[code, line or None, col or None]]
+        self.stress = 1
+        self.mem_cap_mib = None
+        self.problems = []        # each makes the file UNREADABLE
+
+    @property
+    def readable(self):
+        return not self.problems
+
+
+def _bad(e, n, why):
+    e.problems.append(f"{e.path}:{n}: {why}")
+    return e
+
+
+def read_text(text, path):
+    e = Expect(path)
+    for n, raw in enumerate(text.split("\n"), 1):
+        line = raw.strip()
+        if not line.startswith("//"):
+            continue
+        body = line[2:].strip()
+        name = next((m for m in MARKERS_JUDGED + MARKERS_REFUSED if body.startswith(m)), None)
+        if name is None:
+            continue
+        value = body[len(name):].strip()
+        if name in MARKERS_REFUSED:
+            if name == "expect-signal:":
+                _bad(e, n, "`expect-signal:` was retired by @@PD-159@@ -- nothing in this suite is "
+                           "expected to die by a signal, and this runner reads no such marker")
+            else:
+                _bad(e, n, f"`{name}` is a marker this runner does not judge at cycle 0.0.2, "
+                           "so the expectation would go unchecked")
+            continue
+        e.given.add(name)
+        if name == "expect-exit:":
+            if not _INT.match(value):
+                _bad(e, n, f"`expect-exit: {value}` is not an integer (the value is the "
+                           "whole rest of the line)")
+                continue
+            v = int(value)
+            # An exit status is one byte: 321 is reported as 65. A negative value is
+            # `npkg`'s "killed by that signal"; Linux has none below -64.
+            if v > 255 or v < -64:
+                _bad(e, n, f"`expect-exit: {v}` can never be observed: an exit status is "
+                           "one byte, and a signal is -1 ... -64")
+                continue
+            e.exit = v
+        elif name == "expect-error:":
+            if not _CODE.match(value):
+                _bad(e, n, f"`expect-error: {value}` is not a diagnostic code")
+                continue
+            e.errors.append([value, None, None])
+        elif name == "expect-error-at:":
+            m = _AT.match(value)
+            if not m or not e.errors:
+                _bad(e, n, f"`expect-error-at: {value}` -- not `L[:C]`, or no "
+                           "`expect-error:` before it")
+                continue
+            e.errors[-1][1] = int(m.group(1))
+            e.errors[-1][2] = int(m.group(2)) if m.group(2) else None
+        elif name == "stress:":
+            if not _INT.match(value) or int(value) < 1:
+                _bad(e, n, f"`stress: {value}` is not a positive integer")
+                continue
+            e.stress = int(value)
+        elif name == "mem-cap-mib:":
+            if not _INT.match(value) or int(value) < 1:
+                _bad(e, n, f"`mem-cap-mib: {value}` is not a positive integer")
+                continue
+            e.mem_cap_mib = int(value)
+    return e
+
+
+def read(path):
+    with open(path, "rb") as fh:
+        text = fh.read().decode("utf-8", errors="replace")
+    return read_text(text, path)
