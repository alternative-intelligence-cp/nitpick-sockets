+    wr_diff = sorted(got["floorwriter"][0] ^ floor_undef)
+    wr_flagged = irscan.findings(got["floorwriter"][1], floor_edges, "floorwriter")
+    ok = (sys_diff == ["npk_sys6"] and not sys_flagged and wr_diff == ["npk_write"] and len(wr_flagged) == 1
