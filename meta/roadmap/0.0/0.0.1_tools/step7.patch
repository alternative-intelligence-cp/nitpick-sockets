diff --git a/tests/probe/probe15b_unassigned_handoff.npk b/tests/probe/probe15b_unassigned_handoff.npk
new file mode 100644
index 0000000..6bc7b6e
--- /dev/null
+++ b/tests/probe/probe15b_unassigned_handoff.npk
@@ -0,0 +1,42 @@
+// expect-exit: 0
+//
+// PROBE 15b -- AN ARRAY DECLARED WITHOUT AN INITIALISER, HANDED ON AS `$$m`.
+//
+// ASKS: may a program hand a local `uint8[16]` it declared without an initialiser, as an IPv6
+// parser's result is, to a callee as `$$m`; may the callee write its element 0 alone; and does the
+// caller then read element 0 as the value the callee wrote? Nothing reads the other fifteen: storage
+// a `$$m` callee may have left unwritten has no expectation, since DEF-345 leaves the previous
+// frame's bytes there (the workbench's `PLAYBOOK.md` section 2).
+// DEPENDS ON THE ANSWER: ADDRESS_MODEL.md A-22's dated notes, and the research gate's D3 (a
+// result's bytes initialised on the IPv4-in-IPv6 path), whose `$$m` face this probe holds open.
+// EXPECTED: exit 0 at -O0 and through `opt -O2`; code 10 is the assertion. Refused once a re-pin
+// carries DEF-345's fix (the author's ruling (b) of 2026-10-29: a `uint8[16]` does not drop), and it
+// then moves to tests/probe/refused/.
+mod:probe15b_unassigned_handoff;
+
+func:first = NIL(uint8[16]->:p) never fails {
+    (<-p)[0i64] = 7u8;
+    pass NIL;
+};
+
+func:main = int32(cstring[]:_~argv) {
+    uint8[16]:octets;
+    drop first($$m octets);
+    if (octets[0i64] != 7u8) { exit 10i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/probe/probe16_kernel_round_trips.npk b/tests/probe/probe16_kernel_round_trips.npk
new file mode 100644
index 0000000..172def7
--- /dev/null
+++ b/tests/probe/probe16_kernel_round_trips.npk
@@ -0,0 +1,241 @@
+// expect-exit: 0
+//
+// PROBE 16 -- `sockaddr_storage`, `cmsghdr` AND `ucred`, ROUND-TRIPPED THROUGH THE KERNEL.
+//
+// ASKS: A-4's measurement of three of the four sizes probes 02 and 03 assert by `#size_of` alone,
+// each structure laid over a `wild` block whose bytes past it hold a sentinel (0x5A). A 128-byte
+// `sockaddr_storage` holding `::1`, port 0, is `bind`ed with length 129, which the kernel refuses,
+// then with 128, which it takes, and read back by `getsockname` given room for 128: the length 28,
+// the family, a non-zero port, the loopback address, and every byte from 28 to the sentinel at 128
+// untouched. A `cmsghdr` with a `ucred` payload, `cmsg_len` = `CMSG_LEN(12)` = 28 in a control
+// buffer of `CMSG_SPACE(12)` = 32, is filled with the sender's own pid, uid and gid, sent by
+// `sendmsg` over a datagram `socketpair` whose receiver set `SO_PASSCRED`, and received by `recvmsg`
+// into a control buffer of 32: the control length, the header and the three fields as sent, and the
+// sentinel at 32 untouched. `getsockopt(SO_PEERCRED)` given room for 16 writes 12 bytes, the same
+// three, and leaves the sentinel from 12 on.
+// DEPENDS ON THE ANSWER: ADDRESS_MODEL.md A-4 and §2's `sockaddr_storage`, ANCILLARY_MODEL.md §1's
+// layouts and N-13 ... N-16, and SK-016: a size the kernel disagrees with is a table that is wrong.
+// EXPECTED: exit 0 at -O0 and through `opt -O2`. Codes 10 ... 14 and 20 ... 57 are the assertions.
+mod:probe16_kernel_round_trips;
+
+fixed int64:SYS_CLOSE = 3i64;
+fixed int64:SYS_GETPID = 39i64;
+fixed int64:SYS_SOCKET = 41i64;
+fixed int64:SYS_SENDMSG = 46i64;
+fixed int64:SYS_RECVMSG = 47i64;
+fixed int64:SYS_BIND = 49i64;
+fixed int64:SYS_GETSOCKNAME = 51i64;
+fixed int64:SYS_SOCKETPAIR = 53i64;
+fixed int64:SYS_SETSOCKOPT = 54i64;
+fixed int64:SYS_GETSOCKOPT = 55i64;
+fixed int64:SYS_GETUID = 102i64;
+fixed int64:SYS_GETGID = 104i64;
+fixed int64:AF_UNIX = 1i64;
+fixed int64:AF_INET6 = 10i64;
+fixed int64:SOCK_STREAM = 1i64;
+fixed int64:SOCK_DGRAM = 2i64;
+fixed int64:SOCK_NONBLOCK = 2048i64;
+fixed int64:SOCK_CLOEXEC = 524288i64;
+fixed int64:SOL_SOCKET = 1i64;
+fixed int64:SO_PASSCRED = 16i64;
+fixed int64:SO_PEERCRED = 17i64;
+fixed int64:MSG_NOSIGNAL = 16384i64;
+fixed int64:MSG_CTRUNC = 8i64;
+fixed uint8:SENTINEL = 90u8;
+
+struct:SockaddrIn6 = { uint16:family; uint16:port_be; uint32:flow_be; uint8[16]:addr; uint32:scope; };
+struct:SockaddrStorage = { uint16:family; uint8[126]:rest; };
+// `msg_namelen` and `msg_flags` as one 8-byte word each, covering the `int32` and its padding (N-1).
+struct:MsgHdr = {
+    wild int8->:name; int64:namelen;
+    wild int8->:iov; uint64:iovlen;
+    wild int8->:control; uint64:controllen;
+    int64:flags;
+};
+struct:IoVec = { wild int8->:base; uint64:len; };
+struct:CmsgHdr = { uint64:len; int32:level; int32:ctype; };
+struct:Ucred = { int32:cpid; uint32:cuid; uint32:cgid; };
+struct:CmsgCred = { CmsgHdr:hdr; Ucred:cred; int32:pad; };
+
+// The first `n` bytes of `blk` set to the sentinel.
+func:fill = NIL(wild int8->:blk, int64:n) never fails {
+    for (int64:k in 0i64...n) { <-(#ptr_add<uint8>(blk, k)) = SENTINEL; }
+    pass NIL;
+};
+
+// Every byte of `blk` from `from` up to `upto` still holds the sentinel.
+func:untouched = bool(wild int8->:blk, int64:from, int64:upto) never fails {
+    for (int64:k in from...upto) {
+        if ((<-(#ptr_add<uint8>(blk, k))) != SENTINEL) { pass false; }
+    }
+    pass true;
+};
+
+func:main = int32(cstring[]:_~argv) {
+    if (#size_of<SockaddrStorage>() != 128i64) { exit 10i32; }
+    if (#size_of<SockaddrIn6>() != 28i64) { exit 11i32; }
+    if (#size_of<CmsgHdr>() != 16i64) { exit 12i32; }
+    if (#size_of<Ucred>() != 12i64) { exit 13i32; }
+    if (#size_of<CmsgCred>() != 32i64) { exit 14i32; }
+
+    // sockaddr_storage: ::1, port 0, in 128 bytes, the sentinel from 28 to 136
+    wild int8->:sb = alloc(136i64);
+    drop fill(sb, 136i64);
+    wild SockaddrIn6->:s6 = sb =>! wild SockaddrIn6->;
+    wild SockaddrStorage->:ss = sb =>! wild SockaddrStorage->;
+    s6.family = 10u16;
+    s6.port_be = 0u16;
+    s6.flow_be = 0u32;
+    for (int64:k in 0i64...15i64) { s6.addr[k] = 0u8; }
+    s6.addr[15i64] = 1u8;
+    s6.scope = 0u32;
+    int64:kind = (SOCK_STREAM | SOCK_NONBLOCK) | SOCK_CLOEXEC;
+    Result<int64>:rs = sys(SYS_SOCKET, AF_INET6, kind, 0i64);
+    if (rs.is_error) { exit 20i32; }
+    int64:s = rs.value;
+    Result<int64>:rb9 = sys(SYS_BIND, s, sb, 129i64);
+    if (!rb9.is_error) { exit 21i32; }
+    Result<int64>:rb8 = sys(SYS_BIND, s, sb, 128i64);
+    if (rb8.is_error) { exit 22i32; }
+    wild int8->:sl = calloc(1i64, 8i64);
+    <-(#ptr_add<int32>(sl, 0i64)) = 128i32;
+    Result<int64>:rg = sys(SYS_GETSOCKNAME, s, sb, sl);
+    if (rg.is_error) { exit 23i32; }
+    int64:sn = (<-(#ptr_add<int32>(sl, 0i64))) => int64;
+    dalloc(sl);
+    if (sn != 28i64) { exit 24i32; }
+    if (ss.family != 10u16) { exit 25i32; }
+    if (s6.port_be == 0u16) { exit 26i32; }
+    if (s6.addr[15i64] != 1u8) { exit 27i32; }
+    if (s6.addr[0i64] != 0u8) { exit 28i32; }
+    if (!(raw untouched(sb, 28i64, 136i64))) { exit 29i32; }
+    dalloc(sb);
+    Result<int64>:cs = sys(SYS_CLOSE, s);
+    if (cs.is_error) { exit 30i32; }
+
+    // the process's own credentials
+    Result<int64>:gp = sys(SYS_GETPID);
+    Result<int64>:gu = sys(SYS_GETUID);
+    Result<int64>:gg = sys(SYS_GETGID);
+    if (gp.is_error) { exit 31i32; }
+    if (gu.is_error) { exit 32i32; }
+    if (gg.is_error) { exit 33i32; }
+    int32:mypid = gp.value =>! int32;
+    uint32:myuid = gu.value =>! uint32;
+    uint32:mygid = gg.value =>! uint32;
+
+    // a datagram socketpair, its receiver passing credentials
+    wild int8->:sv = alloc(8i64);
+    int64:dkind = (SOCK_DGRAM | SOCK_NONBLOCK) | SOCK_CLOEXEC;
+    Result<int64>:rp = sys(SYS_SOCKETPAIR, AF_UNIX, dkind, 0i64, sv);
+    if (rp.is_error) { exit 34i32; }
+    int64:a = (<-(#ptr_add<int32>(sv, 0i64))) => int64;
+    int64:b = (<-(#ptr_add<int32>(sv, 1i64))) => int64;
+    dalloc(sv);
+    wild int8->:one = calloc(1i64, 8i64);
+    <-(#ptr_add<int32>(one, 0i64)) = 1i32;
+    Result<int64>:ro = sys(SYS_SETSOCKOPT, b, SOL_SOCKET, SO_PASSCRED, one, 4i64);
+    dalloc(one);
+    if (ro.is_error) { exit 35i32; }
+
+    // send one byte with one SCM_CREDENTIALS header, filled with our own pid, uid and gid
+    wild int8->:smb = calloc(1i64, 56i64);
+    wild int8->:svb = calloc(1i64, 16i64);
+    wild int8->:spb = calloc(1i64, 8i64);
+    wild int8->:scb = alloc(40i64);
+    drop fill(scb, 40i64);
+    wild MsgHdr->:sm = smb =>! wild MsgHdr->;
+    wild IoVec->:siv = svb =>! wild IoVec->;
+    wild CmsgCred->:sc = scb =>! wild CmsgCred->;
+    <-(#ptr_add<uint8>(spb, 0i64)) = 99u8;
+    siv.base = spb;
+    siv.len = 1u64;
+    sc.hdr.len = 28u64;
+    sc.hdr.level = 1i32;
+    sc.hdr.ctype = 2i32;
+    sc.cred.cpid = mypid;
+    sc.cred.cuid = myuid;
+    sc.cred.cgid = mygid;
+    sc.pad = 0i32;
+    sm.iov = svb;
+    sm.iovlen = 1u64;
+    sm.control = scb;
+    sm.controllen = 32u64;
+    Result<int64>:rsend = sys(SYS_SENDMSG, a, smb, MSG_NOSIGNAL);
+    dalloc(smb);
+    dalloc(svb);
+    dalloc(spb);
+    dalloc(scb);
+    if (rsend.is_error) { exit 36i32; }
+    if (rsend.value != 1i64) { exit 37i32; }
+
+    // receive it into a control buffer of 32, the sentinel from 32 to 40
+    wild int8->:rmb = calloc(1i64, 56i64);
+    wild int8->:rvb = calloc(1i64, 16i64);
+    wild int8->:rpb = calloc(1i64, 8i64);
+    wild int8->:rcb = alloc(40i64);
+    drop fill(rcb, 40i64);
+    wild MsgHdr->:rm = rmb =>! wild MsgHdr->;
+    wild IoVec->:riv = rvb =>! wild IoVec->;
+    wild CmsgCred->:rc = rcb =>! wild CmsgCred->;
+    riv.base = rpb;
+    riv.len = 1u64;
+    rm.iov = rvb;
+    rm.iovlen = 1u64;
+    rm.control = rcb;
+    rm.controllen = 32u64;
+    Result<int64>:rrecv = sys(SYS_RECVMSG, b, rmb, 0i64);
+    if (rrecv.is_error) { exit 38i32; }
+    if (rrecv.value != 1i64) { exit 39i32; }
+    if ((rm.flags & MSG_CTRUNC) != 0i64) { exit 40i32; }
+    if (rm.controllen != 32u64) { exit 41i32; }
+    if (rc.hdr.len != 28u64) { exit 42i32; }
+    if (rc.hdr.level != 1i32) { exit 43i32; }
+    if (rc.hdr.ctype != 2i32) { exit 44i32; }
+    if (rc.cred.cpid != mypid) { exit 45i32; }
+    if (rc.cred.cuid != myuid) { exit 46i32; }
+    if (rc.cred.cgid != mygid) { exit 47i32; }
+    if (!(raw untouched(rcb, 32i64, 40i64))) { exit 48i32; }
+    if ((<-(#ptr_add<uint8>(rpb, 0i64))) != 99u8) { exit 49i32; }
+    dalloc(rmb);
+    dalloc(rvb);
+    dalloc(rpb);
+    dalloc(rcb);
+
+    // SO_PEERCRED, given room for 16: 12 written, the sentinel from 12 to 24
+    wild int8->:pk = alloc(24i64);
+    drop fill(pk, 24i64);
+    wild Ucred->:pc = pk =>! wild Ucred->;
+    wild int8->:pl = calloc(1i64, 8i64);
+    <-(#ptr_add<int32>(pl, 0i64)) = 16i32;
+    Result<int64>:rk = sys(SYS_GETSOCKOPT, a, SOL_SOCKET, SO_PEERCRED, pk, pl);
+    if (rk.is_error) { exit 50i32; }
+    int64:pn = (<-(#ptr_add<int32>(pl, 0i64))) => int64;
+    dalloc(pl);
+    if (pn != 12i64) { exit 51i32; }
+    if (pc.cpid != mypid) { exit 52i32; }
+    if (pc.cuid != myuid) { exit 53i32; }
