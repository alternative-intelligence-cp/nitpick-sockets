index 0000000..f78e082
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,204 @@
+# nsockets CI.
+#
+# WHAT IS PINNED, AND HOW (@@PD-167@@; the compiler's D-204: the toolchain is a build
+# input). The compiler is a COMMIT, never a branch -- a library whose CI tracks
+# another repository's `main` goes red for reasons that are not its own -- and the
+# checkout is asserted at it and clean, and its emission by digest and size. LLVM
+# is a VERSION: its release tarball is fetched by name and each tool's `--version`
+# asserted; the tarball's own digest and size are not pinned yet, a row of
+# `meta/research/CURRENCY.md` for cycle 0.0.2. The runner image is a NAME, and the
+# first step prints its release and kernel. Bumping a pin is a deliberate commit,
+# and the commit that bumps it is the one that runs the full suite. Modelled on
+# `nitpick-regex`'s workflow and `nitpick-parse`'s plan for one.
+#
+# IT RUNS NO ACTION (@@PD-167@@). Every step is a script of its own: the two checkouts
+# are `git`, LLVM is its release tarball, and nothing is cached, so every run downloads
+# and builds what it uses. An action is code run with this repository's token, and the
+# early ecosystem audit's EK2 found `actions/checkout@v4` and `actions/cache@v4` on
+# floating tags in both the libraries' workflows that use them.
+#
+# WHAT A GREEN RUN PROVES AT CYCLE 0.0.1: the pinned compiler builds from a clean
+# checkout of the pinned commit; its emission is the one the pin recorded; LLVM is
+# exactly 20.1.8; the runner has loopback on 127.0.0.1 and ::1; and the conformance
+# consumer compiles, links, runs and exits 0. `harness/run.py` is a stub that judges
+# nothing until cycle 0.0.2, and says so.
+#
+# EVERY HEX VALUE IS QUOTED. GitHub reads a workflow as YAML 1.2, where a bare run of
+# digits, one `e` and digits is a NUMBER -- `7e91730` is infinity -- so a commit, a
+# short commit and a digest are each a quoted string (`PLAYBOOK.md` §6).
+
+name: nsockets
+
+on:
+  push:
+  pull_request:
+
+permissions:
+  contents: read
+
+env:
+  # The workbench's pinned compiler, by FULL sha (`c9baa9e` in the roadmap).
+  NITPICK_COMMIT: "c9baa9e91c553d8db2a2a62f09c36b30a984b07f"
+  NITPICK_REPO: "https://github.com/alternative-intelligence-cp/nitpick"
+  # THE EMISSION AT THAT COMMIT, as the compiler's own build recorded it -- notice 118's
+  # `npkc.ll` row. The emission step below ASSERTS it: the compiler's D-265 says the
+  # emission, not the binary, is the cross-machine claim. Moved with every pin.
+  NPKC_LL_SHA256: "1f48a31a5c9b5b78053444c404b7b2dd7c8c470c354dd3b14d47b3e75585ee2a"
+  NPKC_LL_BYTES: "31731079"
+  # nitpick.toml's [toolchain] llvm: an exact patch release. Upstream publishes
+  # `LLVM-20.1.8-Linux-X64.tar.xz` at its `llvmorg-20.1.8` release.
+  LLVM_VERSION: "20.1.8"
+
+jobs:
+  build:
+    # The runner image, by name (@@PD-167@@); the first step prints its release and kernel.
+    runs-on: ubuntu-24.04
+    timeout-minutes: 60
+
+    steps:
+      # The runner, printed, since its name is all this file pins of it; and its loopback,
+      # which the `loopback` stage (cycle 0.0.3) runs over: a TCP socket bound to port 0
+      # on 127.0.0.1 and on ::1, and the port each was given read back.
+      - name: The runner, and its loopback
+        run: |
+          set -euo pipefail
+          . /etc/os-release
+          echo "runner image: $PRETTY_NAME ($VERSION_ID), kernel $(uname -r)"
+          python3 --version
+          python3 -I - <<'PY'
+          import socket
+          for family, host in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET6, "::1")):
+              s = socket.socket(family, socket.SOCK_STREAM)
+              s.bind((host, 0))
+              print("loopback %s: bound, port %d" % (host, s.getsockname()[1]))
+              s.close()
+          PY
+
+      # `git`, not an action, with the job's own token in the request's AUTHORIZATION
+      # header, so the fetch is authorised if this repository is private; the commit is
+      # the one this run is for, asserted.
+      - name: Check out nsockets at the commit this run is for
+        env:
+          TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          git init -q .
+          git remote add origin "$GITHUB_SERVER_URL/$GITHUB_REPOSITORY"
+          auth="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$TOKEN" | base64 -w0)"
+          git -c http.extraheader="$auth" fetch -q --depth 1 origin "$GITHUB_SHA"
+          git checkout -q --detach FETCH_HEAD
+          have="$(git rev-parse HEAD)"
+          if [ "$have" != "$GITHUB_SHA" ]; then
+            echo "the checkout is at $have; this run is for $GITHUB_SHA" >&2
+            exit 1
+          fi
+          echo "nsockets HEAD == $have"
+
+      - name: Check out the pinned compiler
+        run: |
+          set -euo pipefail
+          git init -q .nitpick
+          git -C .nitpick fetch -q --depth 1 "$NITPICK_REPO" "$NITPICK_COMMIT"
+          git -C .nitpick checkout -q --detach FETCH_HEAD
+
+      # The fetch names the commit, which should make this redundant. It is the one fact
+      # every claim below rests on, so it is measured, not promised.
+      - name: Assert the compiler is AT the pinned commit
+        run: |
+          set -euo pipefail
+          have="$(git -C .nitpick rev-parse HEAD)"
+          if [ "$have" != "$NITPICK_COMMIT" ]; then
+            echo "compiler checkout is at $have; the pin is $NITPICK_COMMIT" >&2
+            exit 1
+          fi
+          if [ -n "$(git -C .nitpick status --porcelain)" ]; then
+            echo "the compiler checkout is dirty; the pin names a commit" >&2
+            exit 1
+          fi
+          echo "compiler HEAD == $have (clean)"
+
+      # The upstream release tarball: apt.llvm.org packages by MAJOR version and would
+      # give whatever 20.1.x is current. Downloaded on every run, since nothing is cached.
+      - name: Install LLVM ${{ env.LLVM_VERSION }}
+        run: |
+          set -euo pipefail
+          mkdir -p ~/llvm
+          url="https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VERSION}/LLVM-${LLVM_VERSION}-Linux-X64.tar.xz"
+          curl -fsSL "$url" | tar -xJ --strip-components=1 -C ~/llvm
+
+      - name: Put LLVM on PATH and assert the pin
+        run: |
+          set -euo pipefail
+          echo "$HOME/llvm/bin" >> "$GITHUB_PATH"
+          export PATH="$HOME/llvm/bin:$PATH"
+          for t in llc opt ld.lld; do
+            have="$("$t" --version | sed -nE 's/.*(LLVM version|LLD) ([0-9.]+).*/\2/p' | sed -n 1p)"
+            if [ "$have" != "$LLVM_VERSION" ]; then
+              echo "$t is $have; nitpick.toml pins $LLVM_VERSION exactly." >&2
+              exit 1
+            fi
+            echo "$t --version == $have"
+          done
+
+      # The compiler's bootstrap harness, `quickemit.py`, leaves the two artefacts this
+      # library needs -- `npkc` and `npkrt.o` -- in `.internal/quickemit/`.
+      - name: Build the compiler from the pinned commit
+        working-directory: .nitpick
+        run: |
+          set -euo pipefail
+          python3 bootstrap/harness/quickemit.py --keep npkg/main.npk
+
+      - name: Check the toolchain artefacts exist
+        run: |
+          set -euo pipefail
+          test -f .nitpick/.internal/quickemit/npkc
+          test -f .nitpick/.internal/quickemit/npkrt.o
+          echo "NPKC=$GITHUB_WORKSPACE/.nitpick/.internal/quickemit/npkc"   >> "$GITHUB_ENV"
+          echo "NPKRT=$GITHUB_WORKSPACE/.nitpick/.internal/quickemit/npkrt.o" >> "$GITHUB_ENV"
+
+      # THE EMISSION, PRINTED AND ASSERTED. Every artefact the ladder leaves is printed with
+      # its size and digest, so the first that differs names the stage; the emission alone is
+      # asserted, because a binary's bytes may differ by machine and the emission may not.
+      - name: The compiler's emission, asserted against the pin's row
+        working-directory: .nitpick/.internal/quickemit
+        run: |
+          set -euo pipefail
+          echo "compiler pin: $NITPICK_COMMIT"
+          for f in builder.o builder npkrt.o npkc.ll npkc.o npkc; do
+            if [ -f "$f" ]; then
+              printf '%-12s %10s bytes  %s\n' "$f" "$(stat -c '%s' "$f")" "$(sha256sum "$f" | cut -d' ' -f1)"
+            else
+              printf '%-12s %s\n' "$f" "absent"
+            fi
+          done
+          have="$(sha256sum npkc.ll | cut -d' ' -f1)"
+          size="$(stat -c '%s' npkc.ll)"
+          if [ "$have" != "$NPKC_LL_SHA256" ] || [ "$size" != "$NPKC_LL_BYTES" ]; then
+            echo "npkc.ll is $size B / $have; the pin's emission is $NPKC_LL_BYTES B / $NPKC_LL_SHA256." >&2
+            echo "The emission is the cross-machine claim (the compiler's D-265): a compiler defect to raise." >&2
+            exit 1
+          fi
+          echo "npkc.ll == the pin's emission, $size B / $have"
+
+      # A STUB UNTIL CYCLE 0.0.2, and it says so in its output. 0.0.2 replaces this step's
+      # body with one that asserts the runner's unqualified green summary.
+      - name: Run the harness
+        run: python3 -B harness/run.py
+
+      # Until the harness judges it (cycle 0.0.2), the one thing 0.0.1 establishes is run
+      # here in full: the consumer compiles, links, RUNS and exits 0. `npkc` exiting 0
+      # does not mean `llc` accepts the module, so all four steps run and the last is judged.
+      - name: The conformance consumer, all four steps
+        run: |
+          set -euo pipefail
+          work="$RUNNER_TEMP/conformance"
+          mkdir -p "$work"
+          ( cd tests/conformance && "$NPKC" import.npk -o "$work/import.ll" )
+          llc -O0 -filetype=obj -relocation-model=static "$work/import.ll" -o "$work/import.o"
+          ld.lld -static "$work/import.o" "$NPKRT" -o "$work/import"
+          set +e
+          "$work/import"
+          status=$?
+          set -e
+          echo "tests/conformance/import.npk exits $status"
+          test "$status" -eq 0
