diff --git a/tests/unit/bytes_extend.npk b/tests/unit/bytes_extend.npk
new file mode 100644
index 0000000..2bea06e
--- /dev/null
+++ b/tests/unit/bytes_extend.npk
@@ -0,0 +1,65 @@
+// expect-exit: 0
+//
+// `Bytes` -- `bytes_extend`, `bytes_extend_str`, `bytes_clear` and `bytes_take` (`src/core/bytes.npk`).
+//
+// Asserts: an empty slice and an empty string append nothing and do not grow it (10-12); a string that fills the capacity
+// exactly does not grow it (13, 14), and its bytes are there (15, 16); a slice past the capacity grows it by doubling,
+// 2 -> 4 -> 8 (17, 18), appends after the old bytes (19, 20) and keeps them (21); a push fills the last spare byte without
+// growing (22); a 64-byte string grows 8 to 128 and lands whole (23-25); `bytes_take` hands back every byte in order (26)
+// and leaves the sink empty (27); `bytes_clear` empties it and keeps the capacity (28, 29), and the next append starts at
+// 0 (30, 31). The slice `bytes_extend` takes is `fixed uint8[]` -- here `string_bytes`'s read-only view -- and only read.
+mod:bytes_extend;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(2i64);
+    drop bytes_extend(@b, string_bytes(""));
+    if (b.len != 0i64)                                      { exit 10i32; }
+    if ((raw bytes_capacity(b)) != 2i64)                    { exit 11i32; }
+    drop bytes_extend_str(@b, "");
+    if (b.len != 0i64)                                      { exit 12i32; }
+    drop bytes_extend_str(@b, "ab");
+    if (b.len != 2i64)                                      { exit 13i32; }
+    if ((raw bytes_capacity(b)) != 2i64)                    { exit 14i32; }
+    if ((raw bytes_at(b, 0i64)) != 97u8)                    { exit 15i32; }
+    if ((raw bytes_at(b, 1i64)) != 98u8)                    { exit 16i32; }
+    drop bytes_extend(@b, string_bytes("cdefg"));
+    if (b.len != 7i64)                                      { exit 17i32; }
+    if ((raw bytes_capacity(b)) != 8i64)                    { exit 18i32; }
+    if ((raw bytes_at(b, 2i64)) != 99u8)                    { exit 19i32; }
+    if ((raw bytes_at(b, 6i64)) != 103u8)                   { exit 20i32; }
+    if ((raw bytes_at(b, 0i64)) != 97u8)                    { exit 21i32; }
+    drop bytes_push(@b, 104u8);
+    if ((raw bytes_capacity(b)) != 8i64)                    { exit 22i32; }
+    drop bytes_extend_str(@b, "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
+    if (b.len != 72i64)                                     { exit 23i32; }
+    if ((raw bytes_capacity(b)) != 128i64)                  { exit 24i32; }
+    if ((raw bytes_at(b, 71i64)) != 102u8)                  { exit 25i32; }
+    string:all = raw bytes_take(@b);
+    if (!(string_equals(all, "abcdefgh0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"))) { exit 26i32; }
+    if (b.len != 0i64)                                      { exit 27i32; }
+    drop bytes_extend_str(@b, "xyz");
+    drop bytes_clear(@b);
