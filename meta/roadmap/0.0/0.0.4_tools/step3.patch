index 0000000..bdc78bc
--- /dev/null
+++ b/src/core/bytes.npk
@@ -0,0 +1,230 @@
+mod:bytes;
+
+// `src/core/bytes.npk` -- `Bytes`, `nsockets`' byte sink (`meta/specs/BUILD.md` B-13, SK-005).
+//
+// MAY IMPORT: nothing (`meta/specs/BUILD.md` B-18's table); `core` is the bottom layer, and this file has no `use` line.
+//
+// The address formatter's sink (`meta/specs/ADDRESS_MODEL.md` A-23) and the ONLY allocating byte builder in the library:
+// `string_concat` allocates per call, and text built that way piece by piece is the shape the compiler measured as
+// quadratic. A `Bytes` grows by doubling, so a million single-byte pushes are twenty reallocations
+// (`tests/unit/bytes_growth.npk` counts them).
+//
+// ---- EVERY BYTE THROUGH THE BUFFER'S OWN CHECKED INDEX (@@PD-177@@) ----------------------------------------------------
+//
+// The body is a managed `buffer`: it drops at scope exit, so a `Bytes` needs no free and there is no free here to
+// forget. Since the compiler's landing 128 (D-341) a `buffer`'s index `b[i]` is a `uint8` place checked against its
+// length, trapping `OutOfBounds` -- where an index through its `.ptr`, a pointer, is checked by nothing. So this file
+// reads and writes every byte through `buf[i]`, behind its own checks against `len`: no raw `.ptr[i]`, no `#ptr_add`, no
+// `#wild_slice`, and no view of the body at all. `.ptr` appears once, as the pointer `string_from_bytes` takes in
+// `bytes_take`, which copies at once. `buf` is `hidden`, so no other module reaches the body (NITPICK-TYPE-080). A
+// misuse -- an index out of range, a negative capacity, a request whose size no `int64` holds -- stops through
+// `bytes_oob`, the language's own `OutOfBounds`, as `vec.npk`'s stops do; this file has its own copy of that stop so
+// that it imports nothing.
+//
+// ---- NO VIEW OF THE BYTES LEAVES THIS FILE --------------------------------------------------------------------------
+//
+// There is no `bytes_view`: a range of the body, `buf[lo...hi]`, freezes it against an overwrite for the view's whole
+// block, so a sink that handed one out could not grow while it lived, and a `#wild_slice` over `.ptr` would read freed
+// memory after a growth (D-341's own warning). The bytes leave one at a time (`bytes_at`) or all at once as an OWNED
+// copy (`bytes_take`). Growth makes a fresh buffer, copies the live bytes into it by the checked index, and overwrites
+// the field, which drops the old body -- with no view of either held across the overwrite.
+//
+// ---- GROWTH DOUBLES, AND NO MULTIPLY CAN OVERFLOW -------------------------------------------------------------------
+//
+// `bytes_reserve` doubles the capacity, taking the request itself when doubling would pass `int64`'s maximum, the
+// guard computed before every multiply; a request whose `len + need` would overflow is refused before it is added.
+// Every loop is a `for` over a range, so none charges a consumer `DecreasesViolated`. `len` is `sealed` -- read
+// anywhere, written only here (NITPICK-TYPE-079) -- and carries no `limit<...>`. A `Bytes` is move-only, because a
+// `buffer` owns: a copy is NITPICK-TYPE-046, a by-value parameter is a read-only loan, and everything that changes one
+// takes `Bytes->`.
+//
+// ---- `put_uint` DIVIDES BY NOTHING ----------------------------------------------------------------------------------
+//
+// A division charges every consumer `DivByZero` and `DivOverflow`, even by a literal (REACH is import-scoped), and
+// every program that formats an address would import this file; so `bytes_put_uint` finds each decimal digit by
+// subtracting its place's power of ten, most significant first, and allocates nothing but the sink's own growth.
+//
+// Every obligation is a comment in the syntax it would take (`meta/specs/VERIFICATION.md` Z-1a), with a unit standing in.
+
+// ---- the type --------------------------------------------------------------------------------------------------
+
+pub struct:Bytes = {
+    hidden buffer:buf;      // MANAGED, owning, dropped at scope exit. `buf.len` is the CAPACITY.
+    sealed int64:len;       // bytes in use -- never `buf.len`
+};
+
+// `int64`'s maximum, the bound the growth guards are computed against.
+fixed int64:I64_MAX = 9223372036854775807i64;
+
+// ---- the stop ---------------------------------------------------------------------------------------------------
+
+// obligation: never fails ensures false
+//
+// `vec.npk`'s `vec_oob`, this file's copy: a one-element fixed array indexed at -1 or -2, out of range at every `i`,
+// so it never returns.
+func:bytes_oob = NIL(int64:i) never fails {
+    int64[1]:guard = [0i64];
+    int64:below = 0i64 - 1i64 - (i & 1i64);
+    discard(guard[below]);
+    pass NIL;
+};
+
+// ---- construction and reading -----------------------------------------------------------------------------------
+
+// obligation: never fails requires cap >= 0i64
+//             ensures result.len == 0i64 && result.buf.len >= 1i64
+//
+// A NEGATIVE CAPACITY IS A MISUSE AND STOPS; ZERO IS FLOORED TO ONE, as `vec_init` floors it. `buffer_new(n)` is `n`
+// zeroed bytes.
+pub func:bytes_init = Bytes(int64:cap) never fails {
+    if (cap < 0i64) { drop bytes_oob(cap); }
+    int64:n = cap;
+    if (n < 1i64) { n = 1i64; }
+    pass Bytes{ buf: buffer_new(n), len: 0i64 };
+};
+
+// obligation: never fails ensures result == b.len
+//
+// By value -- a loan, read-only -- as every reader here takes its `Bytes`.
+pub func:bytes_len = int64(Bytes:b) never fails {
+    pass b.len;
+};
+
+// obligation: never fails ensures result == b.buf.len
+//
+// THE CAPACITY, which only this file can read (`buf` is `hidden`): what a test asserts growth with.
+pub func:bytes_capacity = int64(Bytes:b) never fails {
+    pass b.buf.len;
+};
+
+// obligation: never fails requires i >= 0i64 && i < b.len
+//
+// The byte at `i`, checked against `len` here and against the capacity by the buffer's own index.
+pub func:bytes_at = uint8(Bytes:b, int64:i) never fails {
+    if (i < 0i64) { drop bytes_oob(i); }
+    if (i >= b.len) { drop bytes_oob(i); }
+    pass b.buf[i];
+};
+
+// obligation: never fails ensures b.len == 0i64 && b.buf.len == old(b.buf.len)
+//
+// THE CAPACITY IS KEPT -- a sink reused clears rather than reallocates -- and the old bytes are not zeroed: past `len`
+// nothing here reads them.
+pub func:bytes_clear = NIL(Bytes->:b) never fails {
+    b.len = 0i64;
+    pass NIL;
+};
+
+// ---- growth -----------------------------------------------------------------------------------------------------
+
+// obligation: never fails requires need >= 0i64 ensures b.buf.len >= b.len + need
+//
+// ROOM FOR `need` MORE bytes, by doubling: a fresh `buffer_new`, the live bytes copied into it by the checked index, and
+// the field overwritten, which drops the old body (there is no `buffer_resize`). Private: the appends are the surface.
+func:bytes_reserve = NIL(Bytes->:b, int64:need) never fails {
+    if (need < 0i64) { drop bytes_oob(need); }
+    if (need > I64_MAX - b.len) { drop bytes_oob(need); }
+    int64:want = b.len + need;
+    if (want <= b.buf.len) { pass NIL; }
+    int64:nc = b.buf.len;
+    if (nc < 1i64) { nc = 1i64; }
+    // The guard runs before every `nc * 2i64`; from 1, at most sixty-two doublings bring `nc` to 2^62 or past it,
+    // where it fires, so the sixty-third turn at the latest ends the loop in a `break`, as in `vec.npk`.
+    for (int64:k in 0i64...63i64) {
+        if (nc >= want) { break; }
+        if (nc > I64_MAX - nc) {
+            nc = want;
+            break;
+        }
+        nc = nc * 2i64;
+    }
+    if (nc < want) { nc = want; }
+    buffer:bigger = buffer_new(nc);
+    for (int64:j in 0i64...b.len) {
+        bigger[j] = b.buf[j];
+    }
+    b.buf = move(bigger);
+    pass NIL;
+};
+
+// ---- appending --------------------------------------------------------------------------------------------------
+
+// obligation: never fails ensures b.len == old(b.len) + 1i64
+pub func:bytes_push = NIL(Bytes->:b, uint8:x) never fails {
+    if (b.len >= b.buf.len) {
+        drop bytes_reserve(b, 1i64);
+        // `bytes_reserve`'s postcondition, checked where the write below relies on it.
+        if (b.len >= b.buf.len) { drop bytes_oob(b.len); }
+    }
+    b.buf[b.len] = x;
+    b.len = b.len + 1i64;
+    pass NIL;
+};
+
+// obligation: never fails ensures b.len == old(b.len) + src.len
+//
+// THE SLICE'S BYTES, after the old ones: one reservation, then each byte by the checked index on both sides. The slice
+// is a read-only parameter, and only read; it cannot be a view of this sink's body, which no other module reaches.
+pub func:bytes_extend = NIL(Bytes->:b, fixed uint8[]:src) never fails {
+    if (src.len <= 0i64) { pass NIL; }
+    drop bytes_reserve(b, src.len);
+    if (src.len > b.buf.len - b.len) { drop bytes_oob(src.len); }
+    for (int64:k in 0i64...src.len) {
+        b.buf[b.len + k] = src[k];
+    }
+    b.len = b.len + src.len;
+    pass NIL;
+};
+
+// obligation: never fails ensures b.len == old(b.len) + string_byte_length(s)
+//
+// `string_bytes` is a read-only view of `s` and allocates nothing.
+pub func:bytes_extend_str = NIL(Bytes->:b, string:s) never fails {
+    drop bytes_extend(b, string_bytes(s));
+    pass NIL;
+};
+
+// obligation: never fails ensures b.len > old(b.len)
+//
+// `v` IN DECIMAL, BY SUBTRACTION AND ALLOCATION-FREE: no `int_to_string`, no `string`, and no `/` or `%` -- each place
+// of `uint64`'s twenty, from 10^19 down, takes its digit as the count of times its power of ten comes off `v`. Every
+// place below the first holds at most nine, so its loop of ten always ends in a `break`; the first, 10^19, at most one,
+// since `uint64`'s maximum is 18446744073709551615. Leading zeros are not written, and zero itself is the one digit
+// "0", the last place's. 10^19 is written as 10^18 times ten, since a `uint64` literal past `int64`'s maximum is
+// NITPICK-LEX-004. Every index is the fixed array's checked one, and each digit goes in by `bytes_push`, so the only
+// allocation is the sink's own growth.
+pub func:bytes_put_uint = NIL(Bytes->:b, uint64:v) never fails {
+    uint64[20]:tens = [1000000000000000000u64 * 10u64, 1000000000000000000u64, 100000000000000000u64,
+                       10000000000000000u64, 1000000000000000u64, 100000000000000u64, 10000000000000u64,
+                       1000000000000u64, 100000000000u64, 10000000000u64, 1000000000u64, 100000000u64,
+                       10000000u64, 1000000u64, 100000u64, 10000u64, 1000u64, 100u64, 10u64, 1u64];
+    uint64:x = v;
+    bool:started = false;
+    for (int64:k in 0i64...tens.len) {
+        uint8:d = 0u8;
+        for (int64:j in 0i64...10i64) {
+            if (x < tens[k]) { break; }
+            x = x - tens[k];
+            d = d + 1u8;
+        }
+        if (d != 0u8 || started || k == tens.len - 1i64) {
+            started = true;
+            drop bytes_push(b, 48u8 + d);
+        }
+    }
+    pass NIL;
+};
+
+// ---- handing the bytes over -------------------------------------------------------------------------------------
+
+// obligation: never fails ensures string_byte_length(result) == old(b.len) && b.len == 0i64
+//
+// THE BYTES, OUT, AS AN OWNED `string`, AND THE SINK EMPTIED. `string_from_bytes` is only a VIEW of the body (cap 0), so
+// the answer is that view concatenated onto "" -- `string_concat` allocates and copies, and is `never fails` -- and it is
+// the caller's to keep: the sink's later growth frees the old body, never the answer. Then `len` goes to 0 with the
+// capacity kept, so taking twice cannot hand the same bytes out twice. It allocates by design, once per finished text.
+pub func:bytes_take = string(Bytes->:b) never fails {
+    string:owned = string_concat("", string_from_bytes(b.buf.ptr, b.len));
+    b.len = 0i64;
+    pass owned;
+};
diff --git a/tests/unit/bytes_at_empty_traps.npk b/tests/unit/bytes_at_empty_traps.npk
new file mode 100644
index 0000000..f5c90e2
--- /dev/null
+++ b/tests/unit/bytes_at_empty_traps.npk
@@ -0,0 +1,34 @@
+// expect-exit: 94
+//
+// `bytes_at` AT 0 OF AN EMPTY `Bytes` STOPS `OutOfBounds`.
+//
+// `i == len == 0`, the index every guard of an empty container passes (`nitpick-regex`'s RX-143); the buffer's own
+// index would pass it too, against a capacity of four.
+//
+// 94 is the failsafe's `OutOfBounds` arm, the language's own identity, which `bytes_oob` raises: reaching it IS the
+// assertion. Were the call to return, `main` would end 50 -- never 94 -- so "the check fired" and "the check is gone"
+// cannot look alike. One case per file, because nothing runs after a trap.
+mod:bytes_at_empty_traps;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(4i64);
+    discard(raw bytes_at(b, 0i64));
+    exit 50i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
