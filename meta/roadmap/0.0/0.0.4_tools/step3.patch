index 0000000..2bf3f1e
--- /dev/null
+++ b/tests/unit/bytes_init_negative_traps.npk
@@ -0,0 +1,32 @@
+// expect-exit: 94
+//
+// `bytes_init` OF A NEGATIVE CAPACITY STOPS `OutOfBounds` (ZERO IS FLOORED TO ONE).
+//
+// As `vec_init`: a negative capacity is a misuse, not a hint.
+//
+// 94 is the failsafe's `OutOfBounds` arm, the language's own identity, which `bytes_oob` raises: reaching it IS the
+// assertion. Were the call to return, `main` would end 50 -- never 94 -- so "the check fired" and "the check is gone"
+// cannot look alike. One case per file, because nothing runs after a trap.
+mod:bytes_init_negative_traps;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(0i64 - 1i64);
+    exit 50i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/bytes_leak_capped.npk b/tests/unit/bytes_leak_capped.npk
new file mode 100644
index 0000000..b6dbc70
--- /dev/null
+++ b/tests/unit/bytes_leak_capped.npk
@@ -0,0 +1,37 @@
+// expect-exit: 0
+// mem-cap-mib: 64
+//
+// `Bytes` -- TEN THOUSAND 64 KiB SINKS, EACH DROPPED AT ITS ITERATION'S END, UNDER A 64 MiB ADDRESS-SPACE CAP.
+//
+// The body is a managed `buffer`, which D-151 does not see, so a forgotten reclaim would not trap at `exit 0` the way a
+// `Vec`'s forgotten free does: this unit holds it under a cap instead (`BUILD.md` B-6a). Each turn makes a sink of
+// 65 536 bytes and writes one byte to it; the sink's scope ends with its turn. Kept, the turns would ask for some 640 MiB
+// and trap `HeapOom` (92) under the cap; reclaimed, the program needs one sink's room at a time and exits 0. The cap's
+// control, the floor program under the same cap, runs first.
+mod:bytes_leak_capped;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    for (int64:i in 0i64...10000i64) {
+        Bytes:b = raw bytes_init(65536i64);
+        drop bytes_push(@b, 1u8);
+        if (b.len != 1i64)                                  { exit 10i32; }
+    }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/bytes_put_uint.npk b/tests/unit/bytes_put_uint.npk
new file mode 100644
index 0000000..fdc8be5
--- /dev/null
+++ b/tests/unit/bytes_put_uint.npk
@@ -0,0 +1,49 @@
+// expect-exit: 0
+//
+// `Bytes` -- `bytes_put_uint` AT 0, 1, 9, 10, 99, 100, 1000 AND `uint64`'S MAXIMUM, EACH APPENDED IN PLACE.
+//
+// Each value is rendered after a marker byte and read back whole through `bytes_take`, so a digit dropped, doubled, out
+// of order or a leading zero written each fails its own exit: 0 (10), 1 (11), 9 (12), 10 (13), 99 (14), 100 (15), 1000
+// -- its zeros inside the number, not leading (16) -- and 18446744073709551615 (17), built as `int64`'s maximum, doubled,
+// plus one, since a `uint64` literal past `int64`'s maximum is NITPICK-LEX-004.
+mod:bytes_put_uint;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(4i64);
+    drop bytes_put_uint(@b, 0u64);
+    if (!(string_equals(raw bytes_take(@b), "0")))                          { exit 10i32; }
+    drop bytes_push(@b, 35u8);
+    drop bytes_put_uint(@b, 1u64);
+    if (!(string_equals(raw bytes_take(@b), "#1")))                         { exit 11i32; }
+    drop bytes_put_uint(@b, 9u64);
+    if (!(string_equals(raw bytes_take(@b), "9")))                          { exit 12i32; }
+    drop bytes_put_uint(@b, 10u64);
+    if (!(string_equals(raw bytes_take(@b), "10")))                         { exit 13i32; }
+    drop bytes_put_uint(@b, 99u64);
+    if (!(string_equals(raw bytes_take(@b), "99")))                         { exit 14i32; }
+    drop bytes_put_uint(@b, 100u64);
+    if (!(string_equals(raw bytes_take(@b), "100")))                        { exit 15i32; }
+    drop bytes_put_uint(@b, 1000u64);
+    if (!(string_equals(raw bytes_take(@b), "1000")))                       { exit 16i32; }
+    uint64:max = (9223372036854775807u64 * 2u64) + 1u64;
+    drop bytes_put_uint(@b, max);
+    if (!(string_equals(raw bytes_take(@b), "18446744073709551615")))       { exit 17i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/bytes_take.npk b/tests/unit/bytes_take.npk
new file mode 100644
index 0000000..b39cd02
--- /dev/null
+++ b/tests/unit/bytes_take.npk
@@ -0,0 +1,39 @@
+// expect-exit: 0
+//
+// `Bytes` -- `bytes_take`'s answer is OWNED: the sink is written while it lives, and it does not change.
+//
+// Asserts: the taken string holds the bytes (10); the sink is empty after (11); the sink is written and grown past its old
+// capacity while the string lives, and the string still reads the same (12) -- a view of the body would have been freed
+// under it by the growth, and the compiler refuses that write while a view lives (D-325); a second take hands back only
+// what was written after the first (13).
+mod:bytes_take;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(4i64);
+    drop bytes_extend_str(@b, "abc");
+    string:first = raw bytes_take(@b);
+    if (!(string_equals(first, "abc")))                     { exit 10i32; }
+    if (b.len != 0i64)                                      { exit 11i32; }
+    drop bytes_extend_str(@b, "a much longer text, past the old capacity of four");
+    if (!(string_equals(first, "abc")))                     { exit 12i32; }
+    string:second = raw bytes_take(@b);
+    if (!(string_equals(second, "a much longer text, past the old capacity of four"))) { exit 13i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
