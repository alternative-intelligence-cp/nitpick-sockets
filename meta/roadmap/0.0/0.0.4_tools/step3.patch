diff --git a/tests/unit/bytes_growth.npk b/tests/unit/bytes_growth.npk
new file mode 100644
index 0000000..f5d5821
--- /dev/null
+++ b/tests/unit/bytes_growth.npk
@@ -0,0 +1,54 @@
+// expect-exit: 0
+//
+// `Bytes` -- A MILLION SINGLE-BYTE PUSHES FROM CAPACITY 1, AND EXACTLY TWENTY REALLOCATIONS.
+//
+// Asserts: a `Bytes` made at capacity 1 is empty (10) with capacity 1 (11); the capacity, read after every push, changes
+// only by exactly doubling (12) and only at the push that found the body full (13) -- so each change IS one reallocation,
+// and counting the changes counts them; the length is the push count (14); twenty reallocations, 1 -> 2 -> ... -> 2^20,
+// the first power of two past a million (15, 16), so growth is amortised linear; and every byte survived every
+// reallocation, read back by `bytes_at` (17, 18). The body is managed and drops at scope exit, so `exit 0` here asserts
+// no `wild` block and says nothing of it; the reallocation count is what bounds the growth.
+mod:bytes_growth;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(1i64);
+    if ((raw bytes_len(b)) != 0i64)                         { exit 10i32; }
+    if ((raw bytes_capacity(b)) != 1i64)                    { exit 11i32; }
+    int64:grown = 0i64;
+    int64:seen = 1i64;
+    for (int64:i in 0i64...1000000i64) {
+        drop bytes_push(@b, ((i & 255i64) =>! uint8));
+        int64:now = raw bytes_capacity(b);
+        if (now != seen) {
+            if (now != seen * 2i64)                         { exit 12i32; }
+            if (i != seen)                                  { exit 13i32; }
+            grown = grown + 1i64;
+            seen = now;
+        }
+    }
+    if (b.len != 1000000i64)                                { exit 14i32; }
+    if (grown != 20i64)                                     { exit 15i32; }
+    if ((raw bytes_capacity(b)) != 1048576i64)              { exit 16i32; }
+    if ((raw bytes_at(b, 999999i64)) != ((999999i64 & 255i64) =>! uint8)) { exit 17i32; }
+    for (int64:j in 0i64...1000000i64) {
+        if ((raw bytes_at(b, j)) != ((j & 255i64) =>! uint8)) { exit 18i32; }
+    }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/bytes_init_negative_traps.npk b/tests/unit/bytes_init_negative_traps.npk
