index 0000000..d75e2ca
--- /dev/null
+++ b/tests/unit/vec_ops.npk
@@ -0,0 +1,58 @@
+// expect-exit: 0
+//
+// `Vec<int64>` -- `vec_init`'s floor, `vec_reserve`, `vec_truncate` and `vec_clear` (`src/core/vec.npk`).
+//
+// Asserts: `vec_init(0)` gives an empty `Vec` of capacity one -- the floor that keeps `cap >= 1` true of every live
+// `Vec`, so that `cap <= 0` marks a freed one (10, 11); `vec_reserve` makes room for `count + need` by doubling and keeps
+// the count and every element (12-15), and a reserve already satisfied changes nothing (16); `vec_truncate` to more than
+// `count` changes nothing and never grows (17), to fewer keeps the first `n` (18, 19), and to 0 empties it (20);
+// `vec_clear` empties it and keeps the capacity (21, 22), and the next push lands at 0 (23).
+mod:vec_ops;
+
+use "../../src/core/vec.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Vec<int64>:v = raw vec_init::<int64>(0i64);
+    if (v.count != 0i64)                                    { exit 10i32; }
+    if (v.cap != 1i64)                                      { exit 11i32; }
+    drop vec_push(@v, 5i64);
+    drop vec_push(@v, 6i64);
+    drop vec_reserve(@v, 5i64);
+    if (v.cap != 8i64)                                      { exit 12i32; }
+    if (v.count != 2i64)                                    { exit 13i32; }
+    if ((raw vec_at(v, 0i64)) != 5i64)                      { exit 14i32; }
+    if ((raw vec_at(v, 1i64)) != 6i64)                      { exit 15i32; }
+    drop vec_reserve(@v, 6i64);
+    if (v.cap != 8i64)                                      { exit 16i32; }
+    drop vec_push(@v, 7i64);
+    drop vec_truncate(@v, 9i64);
+    if (v.count != 3i64)                                    { exit 17i32; }
+    drop vec_truncate(@v, 2i64);
+    if (v.count != 2i64)                                    { exit 18i32; }
+    if ((raw vec_at(v, 1i64)) != 6i64)                      { exit 19i32; }
+    drop vec_truncate(@v, 0i64);
+    if (v.count != 0i64)                                    { exit 20i32; }
+    drop vec_push(@v, 8i64);
+    drop vec_clear(@v);
+    if (v.count != 0i64)                                    { exit 21i32; }
+    if (v.cap != 8i64)                                      { exit 22i32; }
+    drop vec_push(@v, 9i64);
+    if ((raw vec_at(v, 0i64)) != 9i64)                      { exit 23i32; }
+    drop vec_free(@v);
+    exit 0i32;
+};
