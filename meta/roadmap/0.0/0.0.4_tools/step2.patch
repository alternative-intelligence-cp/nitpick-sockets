index 0000000..693f19c
--- /dev/null
+++ b/tests/unit/vec_pod_struct.npk
@@ -0,0 +1,52 @@
+// expect-exit: 0
+//
+// `Vec<V4>` -- A `Copy` STRUCT OF AN ADDRESS'S SHAPE, AT EVERY ACCESSOR (`src/core/vec.npk`).
+//
+// The address types are plain data that derive `Copy` (`meta/specs/ADDRESS_MODEL.md` §1), so a `Vec` of addresses is a
+// `Vec<T: Copy>`; this unit's `V4` is `SocketAddrV4`'s shape -- four octets and a 16-bit field where the address keeps its port, six bytes -- declared here, since
+// `core` imports nothing and `src/addr/` declares no type yet. Asserts: pushed values read back whole (10, 11); `vec_set`
+// replaces one and leaves the other (12, 13); `vec_pop` hands the last back by value (14); and a value read out is a copy
+// the `Vec` does not see change (15).
+mod:vec_pod_struct;
+
+use "../../src/core/vec.npk".*;
+
+#[derive(Copy)]
+struct:V4 = { uint8[4]:octets; uint16:tag; };
+
+func:main = int32(cstring[]:_~argv) {
+    Vec<V4>:v = raw vec_init::<V4>(2i64);
+    drop vec_push(@v, V4{ octets: [127u8, 0u8, 0u8, 1u8], tag: 80u16 });
+    drop vec_push(@v, V4{ octets: [10u8, 1u8, 2u8, 3u8], tag: 443u16 });
+    V4:a = raw vec_at(v, 0i64);
+    if (a.octets[0i64] != 127u8 || a.tag != 80u16)        { exit 10i32; }
+    V4:b = raw vec_at(v, 1i64);
+    if (b.octets[3i64] != 3u8 || b.tag != 443u16)          { exit 11i32; }
+    drop vec_set(@v, 0i64, V4{ octets: [192u8, 168u8, 0u8, 9u8], tag: 22u16 });
+    V4:c = raw vec_at(v, 0i64);
+    if (c.octets[1i64] != 168u8 || c.tag != 22u16)         { exit 12i32; }
+    V4:d = raw vec_at(v, 1i64);
+    if (d.tag != 443u16)                                   { exit 13i32; }
+    V4:e = raw vec_pop(@v);
+    if (e.octets[0i64] != 10u8)                             { exit 14i32; }
