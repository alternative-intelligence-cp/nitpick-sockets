diff --git a/tests/unit/vec_growth.npk b/tests/unit/vec_growth.npk
new file mode 100644
index 0000000..e278e74
--- /dev/null
+++ b/tests/unit/vec_growth.npk
@@ -0,0 +1,49 @@
+// expect-exit: 0
+//
+// `Vec<int64>` -- A HUNDRED THOUSAND PUSHES FROM CAPACITY 1, EACH GROWTH A DOUBLING (`src/core/vec.npk`).
+//
+// Asserts: the capacity, read after every push, changes only by exactly doubling (10) and only at the push that found
+// the block full (11) -- so each change is one reallocation, and counting the changes counts them; the count is the
+// push count (12); seventeen reallocations, 1 -> 2 -> ... -> 2^17, the first power of two past a hundred thousand (13,
+// 14); and every element survived every reallocation, read back in order (15). Then the free, and `exit 0`.
+mod:vec_growth;
+
+use "../../src/core/vec.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Vec<int64>:v = raw vec_init::<int64>(1i64);
+    int64:grown = 0i64;
+    int64:seen = 1i64;
+    for (int64:i in 0i64...100000i64) {
+        drop vec_push(@v, i);
+        if (v.cap != seen) {
+            if (v.cap != seen * 2i64)                       { exit 10i32; }
+            if (i != seen)                                  { exit 11i32; }
+            grown = grown + 1i64;
+            seen = v.cap;
+        }
+    }
+    if (v.count != 100000i64)                               { exit 12i32; }
+    if (grown != 17i64)                                     { exit 13i32; }
+    if (v.cap != 131072i64)                                 { exit 14i32; }
+    for (int64:j in 0i64...100000i64) {
+        if ((raw vec_at(v, j)) != j)                        { exit 15i32; }
+    }
+    drop vec_free(@v);
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
