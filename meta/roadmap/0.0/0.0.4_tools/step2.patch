new file mode 100644
index 0000000..acb073d
--- /dev/null
+++ b/tests/unit/generic_instances.npk
@@ -0,0 +1,43 @@
+// expect-exit: 0
+//
+// EVERY GENERIC FUNCTION `src/` DECLARES, INSTANTIATED HERE -- the root whose emission build step 2's call-edge scan
+// reads for them (`meta/specs/BUILD.md` B-2a, @@PD-177@@).
+//
+// A generic function no root instantiates is in no emission, so the scan of each module under `src/`, compiled alone,
+// cannot see what it calls; this unit calls each one, so its emission defines each instance, `npk.<module>.<name><T>`,
+// and the build step reads that emission as it reads a module's, and finds a generic with no instance here a finding
+// of its own. The private generic `vec_bytes` is instantiated through `vec_init` and `vec_reserve`. `int64` is the type
+// each is called at: every bound here is `T: Copy`, and what an instance reaches through its type argument is that
+// argument's. As a unit it runs too, and exits 0.
+mod:generic_instances;
+
+use "../../src/core/vec.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Vec<int64>:v = raw vec_init::<int64>(2i64);
+    drop vec_reserve(@v, 3i64);
+    drop vec_push(@v, 1i64);
+    drop vec_push(@v, 2i64);
+    drop vec_set(@v, 0i64, 3i64);
