diff --git a/tests/unit/vec_truncate_after_free_traps.npk b/tests/unit/vec_truncate_after_free_traps.npk
new file mode 100644
index 0000000..82acd1f
--- /dev/null
+++ b/tests/unit/vec_truncate_after_free_traps.npk
@@ -0,0 +1,35 @@
+// expect-exit: 94
+//
+// `vec_truncate` ON A FREED `Vec` STOPS `OutOfBounds`.
+//
+// A truncation changes nothing past `count`, so without the check it would pass over a dead `Vec` in silence.
+//
+// 94 is the failsafe's `OutOfBounds` arm, the language's own identity, which `vec_oob` raises: reaching it IS the
+// assertion. Were the call to return, `main` would end 50 -- never 94 -- so "the check fired" and "the check is gone"
+// cannot look alike. One case per file, because nothing runs after a trap.
+mod:vec_truncate_after_free_traps;
+
+use "../../src/core/vec.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Vec<int64>:v = raw vec_init::<int64>(4i64);
+    drop vec_push(@v, 1i64);
+    drop vec_free(@v);
+    drop vec_truncate(@v, 0i64);
+    exit 50i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
