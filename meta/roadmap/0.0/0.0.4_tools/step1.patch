@@ -0,0 +1,32 @@
+// expect-exit: 0
+//
+// `src/core/limits.npk` -- EACH BOUND HAS THE VALUE ITS RULE STATES.
+//
+// One assertion per bound, each its own exit: 10 `NSOCK_CMSG_MAX` is 256 (`ANCILLARY_MODEL.md` N-4), 11
+// `NSOCK_SCM_MAX_FDS` is 16 (`ANCILLARY_MODEL.md` N-5), 12 `NSOCK_EMFILE_BACKOFF` is 50 (`CONCURRENCY_MODEL.md` C-11).
+// The expected values are the rules' numbers spelled out here, apart from the file under test, so a constant edited
+// there and not in its rule is a red run beside `check_constants_named`'s finding. Importing the file costs only the
+// floor's six arms: it declares no function.
+mod:limits_values;
+
+use "../../src/core/limits.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    if (NSOCK_CMSG_MAX != 256i64)           { exit 10i32; }
+    if (NSOCK_SCM_MAX_FDS != 16i64)         { exit 11i32; }
+    if (NSOCK_EMFILE_BACKOFF != 50i64)      { exit 12i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
